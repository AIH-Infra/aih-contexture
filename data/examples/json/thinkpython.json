          "children": null,
          "section_hierarchy": {
            "1": "/page/108/SectionHeader/1",
            "3": "/page/112/SectionHeader/1"
          },
          "images": {}
        },
        {
          "id": "/page/112/TextInlineMath/14",
          "block_type": "TextInlineMath",
          "html": "<p>def capitalize_all(t): res = [] for s in t: res.append(s.capitalize()) return res</p>",
          "polygon": [
            [
              130.0,
              471.0
            ],
            [
              307.0,
              471.0
            ],
            [
              307.0,
              533.671875
            ],
            [
              130.0,
              533.671875
            ]
          ],
          "children": null,
          "section_hierarchy": {
            "1": "/page/108/SectionHeader/1",
            "3": "/page/112/SectionHeader/1"
          },
          "images": {}
        },
        {
          "id": "/page/112/Text/15",
          "block_type": "Text",
          "html": "<p>res is initialized with an empty list; each time through the loop, we append the next element. So res is another kind of accumulator.</p>",
          "polygon": [
            [
              129.69140625,
              536.0
