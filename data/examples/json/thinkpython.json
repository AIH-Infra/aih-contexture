        {
          "id": "/page/113/SectionHeader/6",
          "block_type": "SectionHeader",
          "html": "<h3><b>10.8 Deleting elements</b></h3>",
          "polygon": [
            [
              86.0,
              271.283203125
            ],
            [
              246.0,
              271.283203125
            ],
            [
              246.0,
