            "3": "/page/89/SectionHeader/13"
          },
          "images": {}
        },
        {
          "id": "/page/90/Text/2",
          "block_type": "Text",
          "html": "<p><b>initialization:</b> An assignment that gives an initial value to a variable that will be updated.</p>",
          "polygon": [
