          "children": null,
          "section_hierarchy": {
            "1": "/page/52/SectionHeader/1",
            "3": "/page/52/SectionHeader/3"
          },
          "images": {}
        },
        {
          "id": "/page/52/Text/8",
          "block_type": "Text",
          "html": "<p>If you downloaded the Swampy modules but did not install them as a package, you can either work in the directory that contains the Swampy files, or add that directory to Python's search path. Then you can import TurtleWorld like this:</p>",
          "polygon": [
            [
