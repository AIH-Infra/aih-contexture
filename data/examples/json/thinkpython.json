        {
          "id": "/page/108/Code/11",
          "block_type": "Code",
          "html": "<pre>&gt;&gt;&gt; cheeses = [Cheddar, Edam, Gouda]\n&gt;&gt;&gt; numbers = [17, 123]\n&gt;&gt;&gt; empty = []\n&gt;&gt;&gt; print cheeses, numbers, empty\n['Cheddar', 'Edam', 'Gouda'] [17, 123] []</pre>",
