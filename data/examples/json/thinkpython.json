              },
              "images": {}
            },
            {
              "id": "/page/186/ListItem/7",
              "block_type": "ListItem",
              "html": "<li><b>subject:</b> The object a method is invoked on.</li>",
              "polygon": [
                [
                  128.72021484375,
                  362.0
                ],
                [
                  324.228515625,
                  362.0
                ],
                [
