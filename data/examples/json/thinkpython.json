        },
        {
          "id": "/page/153/Text/11",
          "block_type": "Text",
          "html": "<p><i>where s and c are parameters that depend on the language and the text. If you take the logarithm of</i> <i>both sides of this equation, you get:</i></p>",
          "polygon": [
            [
              85.3154296875,
              398.70703125
            ],
            [
              484.1015625,
              398.70703125
            ],
            [
              484.1015625,
              422.0
            ],
            [
              85.3154296875,
              422.0
            ]
          ],
          "children": null,
          "section_hierarchy": {
