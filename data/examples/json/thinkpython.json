        {
          "id": "/page/221/SectionHeader/1",
          "block_type": "SectionHeader",
          "html": "<h3><b>A.3.4 I'm really, really stuck and I need help.</b></h3>",
          "polygon": [
            [
              86.0,
              86.47998046875
            ],
            [
              338.87109375,
              84.93310546875
            ],
            [
              338.87109375,
              99.0
            ],
            [
              86.0,
              99.966796875
            ]
          ],
          "children": null,
          "section_hierarchy": {
            "1": "/page/214/SectionHeader/1",
            "3": "/page/221/SectionHeader/1"
          },
          "images": {}
        },
        {
          "id": "/page/221/Text/2",
          "block_type": "Text",
          "html": "<p>First, try getting away from the computer for a few minutes. Computers emit waves that affect the brain, causing these symptoms:</p>",
          "polygon": [
            [
              85.763671875,
              108.3779296875
            ],
            [
              484.69921875,
              108.3779296875
            ],
            [
              484.69921875,
              133.0
            ],
            [
              85.763671875,
