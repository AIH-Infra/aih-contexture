          "section_hierarchy": {
            "1": "/page/4/SectionHeader/0",
            "3": "/page/4/SectionHeader/1"
          },
          "images": null
        },
        {
          "id": "/page/5/Text/8",
          "block_type": "Text",
          "html": "<p>I hope you enjoy working with this book, and that it helps you learn to program and think, at least a little bit, like a computer scientist.</p>",
          "polygon": [
            [
              85.3154296875,
              371.63671875
