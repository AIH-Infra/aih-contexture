          ],
          "children": null,
          "section_hierarchy": {
            "1": "/page/84/SectionHeader/1",
            "3": "/page/90/SectionHeader/7"
          },
          "images": {}
        },
        {
          "id": "/page/90/Code/9",
          "block_type": "Code",
          "html": "<pre>1.0 1.0 1.0 0.0\n2.0 1.41421356237 1.41421356237 2.22044604925e-16\n3.0 1.73205080757 1.73205080757 0.0\n4.0 2.0 2.0 0.0\n5.0 2.2360679775 2.2360679775 0.0\n6.0 2.44948974278 2.44948974278 0.0\n7.0 2.64575131106 2.64575131106 0.0\n8.0 2.82842712475 2.82842712475 4.4408920985e-16\n9.0 3.0 3.0 0.0</pre>",
          "polygon": [
            [
