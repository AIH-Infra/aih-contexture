            ]
          ],
          "children": null,
          "section_hierarchy": {
            "1": "/page/154/SectionHeader/1",
            "3": "/page/155/SectionHeader/3"
          },
          "images": {}
        },
        {
          "id": "/page/155/Code/5",
          "block_type": "Code",
          "html": "<pre>&gt;&gt;&gt; x = 52\n&gt;&gt;&gt; fout.write(str(x))</pre>",
          "polygon": [
            [
              86.0,
              281.53125
            ],
            [
              201.8583984375,
              281.53125
            ],
            [
              201.0,
              305.12109375
            ],
            [
              85.3154296875,
              305.12109375
            ]
          ],
          "children": null,
          "section_hierarchy": {
            "1": "/page/154/SectionHeader/1",
            "3": "/page/155/SectionHeader/3"
          },
          "images": {}
        },
        {
          "id": "/page/155/Text/6",
          "block_type": "Text",
          "html": "<p>An alternative is to use the <b>format operator</b>, %. When applied to integers, % is the modulus operator. But when the first operand is a string, % is the format operator.</p>",
          "polygon": [
            [
              85.6142578125,
              310.341796875
            ],
            [
              482.90625,
              310.341796875
            ],
            [
              482.90625,
              334.0
            ],
            [
              85.6142578125,
              334.0
            ]
          ],
          "children": null,
          "section_hierarchy": {
