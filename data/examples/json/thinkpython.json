            "3": "/page/112/SectionHeader/1"
          },
          "images": {}
        },
        {
          "id": "/page/112/Text/16",
          "block_type": "Text",
          "html": "<p>An operation like capitalize_all is sometimes called a map because it \"maps\" a function (in this case the method capitalize) onto each of the elements in a sequence.</p>",
          "polygon": [
            [
              128.794921875,
              568.4765625
