        {
          "id": "/page/117/SectionHeader/12",
          "block_type": "SectionHeader",
          "html": "<h3><b>10.13 Debugging</b></h3>",
          "polygon": [
            [
              85.9130859375,
              428.09765625
            ],
            [
              207.685546875,
              428.09765625
            ],
