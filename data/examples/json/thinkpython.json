    {
      "id": "/page/161/Page/227",
      "block_type": "Page",
      "html": "<content-ref src='/page/161/PageHeader/0'></content-ref><content-ref src='/page/161/PageHeader/16'></content-ref><content-ref src='/page/161/Text/1'></content-ref><content-ref src='/page/161/Code/2'></content-ref><content-ref src='/page/161/Text/3'></content-ref><content-ref src='/page/161/Text/4'></content-ref><content-ref src='/page/161/Text/5'></content-ref><content-ref src='/page/161/TextInlineMath/6'></content-ref><content-ref src='/page/161/Text/7'></content-ref><content-ref src='/page/161/Text/8'></content-ref><content-ref src='/page/161/Text/9'></content-ref><content-ref src='/page/161/Text/10'></content-ref><content-ref src='/page/161/SectionHeader/11'></content-ref><content-ref src='/page/161/Text/12'></content-ref><content-ref src='/page/161/Code/13'></content-ref><content-ref src='/page/161/Text/14'></content-ref><content-ref src='/page/161/Code/15'></content-ref>",
      "polygon": [
        [
          0.0,
