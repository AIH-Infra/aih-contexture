        {
          "id": "/page/155/SectionHeader/3",
          "block_type": "SectionHeader",
          "html": "<h3><b>14.3 Format operator</b></h3>",
          "polygon": [
            [
              85.68896484375,
              226.23046875
            ],
            [
              231.0,
              224.68359375
            ],
