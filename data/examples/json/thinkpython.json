      "id": "/page/22/Page/95",
      "block_type": "Page",
      "html": "<content-ref src='/page/22/SectionHeader/0'></content-ref><content-ref src='/page/22/SectionHeader/1'></content-ref><content-ref src='/page/22/Text/2'></content-ref><content-ref src='/page/22/Text/3'></content-ref><content-ref src='/page/22/Text/4'></content-ref><content-ref src='/page/22/SectionHeader/5'></content-ref><content-ref src='/page/22/Text/6'></content-ref><content-ref src='/page/22/Text/7'></content-ref><content-ref src='/page/22/Text/8'></content-ref>",
      "polygon": [
