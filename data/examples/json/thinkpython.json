          "children": null,
          "section_hierarchy": {
            "1": "/page/108/SectionHeader/1",
            "3": "/page/116/SectionHeader/11"
          },
          "images": {}
        },
        {
          "id": "/page/116/Text/14",
          "block_type": "Text",
          "html": "<p>Here's how it is used: ''</p>",
          "polygon": [
            [
              129.2431640625,
              514.72265625
