      "children": [
        {
          "id": "/page/84/SectionHeader/0",
          "block_type": "SectionHeader",
          "html": "<h3><b>Chapter 7</b></h3>",
          "polygon": [
            [
              129.09375,
              163.6787109375
            ],
            [
              221.0,
              163.6787109375
            ],
            [
              221.0,
