          "children": null,
          "section_hierarchy": {
            "1": "/page/52/SectionHeader/1",
            "3": "/page/52/SectionHeader/3"
          },
          "images": {}
        },
        {
          "id": "/page/52/Text/7",
          "block_type": "Text",
          "html": "<p>from swampy.TurtleWorld import *</p>",
          "polygon": [
            [
              128.72021484375,
              476.82421875
            ],
            [
              298.828125,
              476.82421875
            ],
            [
