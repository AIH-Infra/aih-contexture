          "children": null,
          "section_hierarchy": {
            "1": "/page/164/SectionHeader/1",
            "3": "/page/166/SectionHeader/7"
          },
          "images": {}
        },
        {
          "id": "/page/166/Text/16",
          "block_type": "Text",
          "html": "<p>To represent a rectangle, you have to instantiate a Rectangle object and assign values to the attributes:</p>",
          "polygon": [
