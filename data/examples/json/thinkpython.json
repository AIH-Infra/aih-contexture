            ]
          ],
          "children": null,
          "section_hierarchy": {
            "1": "/page/32/SectionHeader/1",
            "3": "/page/37/SectionHeader/6"
          },
          "images": {}
        },
        {
          "id": "/page/37/Text/16",
          "block_type": "Text",
          "html": "<p>This comment contains useful information that is not in the code:</p>",
          "polygon": [
            [
              86.0,
              559.96875
            ],
            [
              375.92578125,
              559.96875
            ],
            [
              375.92578125,
              571.0
            ],
            [
              86.0,
              571.0
            ]
          ],
          "children": null,
          "section_hierarchy": {
            "1": "/page/32/SectionHeader/1",
            "3": "/page/37/SectionHeader/6"
          },
          "images": {}
        },
        {
          "id": "/page/37/Text/17",
          "block_type": "Text",
          "html": "<p>v = 5 # velocity in meters/second.</p>",
          "polygon": [
            [
              85.98779296875,
              575.82421875
            ],
            [
              285.0,
              575.82421875
            ],
            [
              285.0,
              586.65234375
            ],
            [
              85.98779296875,
              586.65234375
            ]
          ],
          "children": null,
          "section_hierarchy": {
            "1": "/page/32/SectionHeader/1",
            "3": "/page/37/SectionHeader/6"
          },
          "images": {}
        },
        {
          "id": "/page/37/Text/18",
          "block_type": "Text",
          "html": "<p>Good variable names can reduce the need for comments, but long names can make complex expressions hard to read, so there is a tradeoff.</p>",
          "polygon": [
            [
              85.0166015625,
              589.74609375
            ],
            [
              483.50390625,
              588.19921875
            ],
            [
              483.50390625,
              613.0
            ],
            [
              85.0166015625,
              613.0
            ]
          ],
          "children": null,
          "section_hierarchy": {
            "1": "/page/32/SectionHeader/1",
            "3": "/page/37/SectionHeader/19"
          },
          "images": {}
        },
        {
          "id": "/page/37/SectionHeader/19",
          "block_type": "SectionHeader",
          "html": "<h3><b>2.10 Debugging</b></h3>",
          "polygon": [
