        {
          "id": "/page/202/Text/1",
          "block_type": "Text",
          "html": "<p>button2 = g.bu(text=No, press me!, command=make_label)</p>",
          "polygon": [
            [
              128.57080078125,
              89.0
            ],
            [
              426.12890625,
