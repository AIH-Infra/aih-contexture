          },
          "images": {}
        },
        {
          "id": "/page/45/Text/17",
          "block_type": "Text",
          "html": "<p>'</p>",
          "polygon": [
            [
              196.0,
              75.0
            ],
            [
              201.0,
              75.0
            ],
            [
              201.0,
              85.0
            ],
            [
