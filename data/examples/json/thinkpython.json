      "children": [
        {
          "id": "/page/152/PageHeader/0",
          "block_type": "PageHeader",
          "html": "<p><b>13.10. Debugging 131</b></p>",
          "polygon": [
            [
              128.6455078125,
              61.0
            ],
            [
              526.0,
              61.0
            ],
            [
              526.0,
              71.10791015625
            ],
            [
