          "images": {}
        },
        {
          "id": "/page/85/Text/15",
          "block_type": "Text",
          "html": "<p>Another is the while statement. Here is a version of countdown that uses a while statement:</p>",
          "polygon": [
            [
              86.0,
              538.3125
            ],
            [
              483.205078125,
              538.3125
            ],
            [
              483.205078125,
              550.0
