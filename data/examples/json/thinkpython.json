        {
          "id": "/page/177/ListGroup/146",
          "block_type": "ListGroup",
          "html": "<p><ul><content-ref src='/page/177/ListItem/1'></content-ref><content-ref src='/page/177/ListItem/2'></content-ref><content-ref src='/page/177/ListItem/3'></content-ref><content-ref src='/page/177/ListItem/4'></content-ref></ul></p>",
