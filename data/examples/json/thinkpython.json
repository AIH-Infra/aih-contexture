            "3": "/page/200/SectionHeader/2"
          },
          "images": {}
        },
        {
          "id": "/page/201/Text/6",
          "block_type": "Text",
          "html": "<p><b>Scrollbar:</b> A widget that controls the visible part of another widget.</p>",
          "polygon": [
