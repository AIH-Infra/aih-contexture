          "children": null,
          "section_hierarchy": {
            "1": "/page/200/SectionHeader/1",
            "3": "/page/201/SectionHeader/9"
          },
          "images": {}
        },
        {
          "id": "/page/201/Text/17",
          "block_type": "Text",
          "html": "<p>By default, Tkinter stacks the widgets top-to-bottom and centers them. We'll see how to override that behavior soon.</p>",
          "polygon": [
            [
              85.9130859375,
              555.71484375
            ],
            [
              484.1015625,
              555.71484375
            ],
            [
              484.1015625,
              579.0
            ],
