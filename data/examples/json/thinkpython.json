            [
              85.46484375,
              621.0703125
            ]
          ],
          "children": null,
          "section_hierarchy": {
            "1": "/page/178/SectionHeader/1",
            "3": "/page/181/SectionHeader/8"
          },
          "images": {}
        },
        {
          "id": "/page/181/Code/20",
          "block_type": "Code",
          "html": "<pre>&gt;&gt;&gt; time = Time(9, 45)\n&gt;&gt;&gt; time.print_time()\n09:45:00</pre>",
          "polygon": [
            [
