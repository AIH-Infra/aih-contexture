          "children": null,
          "section_hierarchy": {
            "1": "/page/84/SectionHeader/1",
            "3": "/page/85/SectionHeader/12"
          },
          "images": {}
        },
        {
          "id": "/page/85/Code/16",
          "block_type": "Code",
          "html": "<pre>def countdown(n):\n    while n &gt; 0:\n        print n\n        n = n-1\n    print 'Blastoff!'</pre>",
          "polygon": [
            [
              86.0,
              555.328125
            ],
            [
              196.0,
              555.328125
            ],
            [
              196.0,
              616.4296875
            ],
            [
              86.0,
              616.4296875
            ]
