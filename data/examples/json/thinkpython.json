          "images": {}
        },
        {
          "id": "/page/237/SectionHeader/5",
          "block_type": "SectionHeader",
          "html": "<h4>point = instantiate(Point)</h4>",
          "polygon": [
            [
              85.6142578125,
              490.74609375
