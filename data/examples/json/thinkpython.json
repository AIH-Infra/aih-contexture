                ],
                [
                  525.9375,
                  426.9375
                ],
                [
                  525.9375,
                  452.0
                ],
                [
                  141.1962890625,
                  452.0
                ]
              ],
              "children": null,
              "section_hierarchy": {
                "1": "/page/222/SectionHeader/1",
                "3": "/page/223/SectionHeader/5"
              },
              "images": {}
            },
            {
              "id": "/page/224/ListItem/8",
              "block_type": "ListItem",
              "html": "<li><i>2. What is the order of growth of</i> (n 2 + n) · (n + 1)<i>? Before you start multiplying, remember</i> <i>that you only need the leading term.</i></li>",
              "polygon": [
                [
                  140.8974609375,
                  461.0
                ],
                [
                  526.0,
                  461.0
                ],
                [
                  526.0,
                  485.33203125
                ],
                [
                  140.8974609375,
