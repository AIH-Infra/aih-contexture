            "3": "/page/64/SectionHeader/5"
          },
          "images": {}
        },
        {
          "id": "/page/64/Code/9",
          "block_type": "Code",
          "html": "<pre>if choice == a:\n    draw_a()\nelif choice == 'b':\n    draw_b()\nelif choice == 'c':\n    draw_c()</pre>",
          "polygon": [
            [
              127.8984375,
              456.71484375
            ],
            [
              229.0,
              456.71484375
            ],
            [
              229.0,
              528.0
            ],
            [
              127.8984375,
              528.0
            ]
