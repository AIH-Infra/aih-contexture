      "children": [
        {
          "id": "/page/176/PageHeader/0",
          "block_type": "PageHeader",
          "html": "<p><b>16.5. Debugging 155</b></p>",
          "polygon": [
            [
              128.3466796875,
              61.0
            ],
            [
              526.0,
              61.0
            ],
            [
              526.0,
              71.0595703125
            ],
            [
              128.3466796875,
              71.0595703125
            ]
          ],
          "children": null,
          "section_hierarchy": {
            "1": "/page/172/SectionHeader/1",
