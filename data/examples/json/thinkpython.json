          },
          "images": {}
        },
        {
          "id": "/page/43/Text/13",
          "block_type": "Text",
          "html": "<p>Pulling together the code fragments from the previous section, the whole program looks like this:</p>",
          "polygon": [
            [
              86.0,
              512.40234375
            ],
            [
              482.30859375,
              512.40234375
            ],
            [
              482.30859375,
              536.0
