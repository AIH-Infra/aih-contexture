            "3": "/page/201/SectionHeader/9"
          },
          "images": {}
        },
        {
          "id": "/page/202/Text/27",
          "block_type": "Text",
          "html": "<p>'</p>",
          "polygon": [
            [
              307.0,
              75.0
            ],
