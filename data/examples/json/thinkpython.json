          "children": null,
          "section_hierarchy": {
            "1": "/page/108/SectionHeader/1",
            "3": "/page/112/SectionHeader/1"
          },
          "images": {}
        },
        {
          "id": "/page/112/Text/17",
          "block_type": "Text",
          "html": "<p><b>Exercise 10.2.</b> Use capitalize_all <i>to write a function named</i> capitalize_nested <i>that takes</i> <i>a nested list of strings and returns a new nested list with all strings capitalized.</i></p>",
          "polygon": [
