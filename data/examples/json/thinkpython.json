              86.0,
              264.322265625
            ],
            [
              483.50390625,
              264.322265625
            ],
            [
              483.50390625,
              287.0
            ],
            [
              86.0,
              287.0
            ]
          ],
          "children": null,
          "section_hierarchy": {
            "1": "/page/200/SectionHeader/1",
            "3": "/page/201/SectionHeader/9"
          },
          "images": {}
        },
        {
          "id": "/page/201/SectionHeader/9",
          "block_type": "SectionHeader",
          "html": "<h3><b>19.2 Buttons and callbacks</b></h3>",
          "polygon": [
            [
