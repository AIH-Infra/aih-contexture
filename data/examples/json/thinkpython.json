              111.0
            ]
          ],
          "children": null,
          "section_hierarchy": {
            "1": "/page/40/SectionHeader/1",
            "3": "/page/47/SectionHeader/2"
          },
          "images": {}
        },
        {
          "id": "/page/47/SectionHeader/2",
          "block_type": "SectionHeader",
          "html": "<h3><b>3.11 Fruitful functions and void functions</b></h3>",
          "polygon": [
            [
              85.0166015625,
              138.9287109375
            ],
            [
              370.546875,
              138.9287109375
            ],
            [
              370.546875,
              154.0
            ],
            [
              85.0166015625,
              154.0
            ]
          ],
          "children": null,
          "section_hierarchy": {
            "1": "/page/40/SectionHeader/1",
            "3": "/page/47/SectionHeader/2"
          },
          "images": {}
        },
        {
          "id": "/page/47/Text/3",
          "block_type": "Text",
          "html": "<p>Some of the functions we are using, such as the math functions, yield results; for lack of a better name, I call them <b>fruitful functions</b>. Other functions, like print_twice, perform an action but don't return a value. They are called <b>void functions</b>.</p>",
          "polygon": [
            [
              85.3154296875,
              166.0
            ],
            [
              482.30859375,
              166.0
            ],
            [
              482.30859375,
              201.09375
            ],
            [
              85.3154296875,
              201.09375
            ]
          ],
          "children": null,
          "section_hierarchy": {
            "1": "/page/40/SectionHeader/1",
            "3": "/page/47/SectionHeader/2"
          },
          "images": {}
        },
        {
          "id": "/page/47/Text/4",
          "block_type": "Text",
          "html": "<p>When you call a fruitful function, you almost always want to do something with the result; for example, you might assign it to a variable or use it as part of an expression:</p>",
          "polygon": [
            [
              84.8671875,
              209.98828125
            ],
            [
              483.205078125,
              209.98828125
            ],
            [
              483.205078125,
              232.41796875
            ],
            [
              84.8671875,
              232.41796875
            ]
          ],
          "children": null,
          "section_hierarchy": {
            "1": "/page/40/SectionHeader/1",
            "3": "/page/47/SectionHeader/2"
          },
          "images": {}
        },
        {
          "id": "/page/47/TextInlineMath/5",
          "block_type": "TextInlineMath",
          "html": "<p>x = math.cos(radians) golden = (math.sqrt(5) + 1) / 2 When you call a function in interactive mode, Python displays the result:</p>",
          "polygon": [
            [
              85.46484375,
              237.05859375
            ],
            [
              413.876953125,
              235.51171875
            ],
            [
              413.876953125,
              276.0
            ],
            [
              85.46484375,
              276.0
            ]
          ],
          "children": null,
          "section_hierarchy": {
            "1": "/page/40/SectionHeader/1",
            "3": "/page/47/SectionHeader/2"
          },
          "images": {}
        },
        {
          "id": "/page/47/Text/6",
          "block_type": "Text",
          "html": "<p>&gt;&gt;&gt; math.sqrt(5)</p>",
          "polygon": [
            [
              85.0166015625,
              276.697265625
