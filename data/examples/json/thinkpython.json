              556.1015625
            ]
          ],
          "children": null,
          "section_hierarchy": {
            "1": "/page/40/SectionHeader/1",
            "3": "/page/45/SectionHeader/8"
          },
          "images": {}
        },
        {
          "id": "/page/45/Text/11",
          "block_type": "Text",
          "html": "<p>This function takes two arguments, concatenates them, and prints the result twice. Here is an example that uses it: ''</p>",
          "polygon": [
            [
              85.6142578125,
              558.421875
            ],
            [
              482.0,
              558.421875
            ],
            [
              482.0,
              583.0
            ],
            [
              85.6142578125,
              583.0
            ]
          ],
          "children": null,
          "section_hierarchy": {
            "1": "/page/40/SectionHeader/1",
            "3": "/page/45/SectionHeader/8"
          },
          "images": {}
        },
        {
          "id": "/page/45/Code/12",
          "block_type": "Code",
          "html": "<pre>&gt;&gt;&gt; line1 = Bing tiddle \n                           \n&gt;&gt;&gt; line2 = 'tiddle bang.'\n                           \n&gt;&gt;&gt; cat_twice(line1, line2)\nBing tiddle tiddle bang.\nBing tiddle tiddle bang.</pre>",
          "polygon": [
            [
              84.4189453125,
              586.0
            ],
            [
              228.0,
              586.0
            ],
            [
              228.0,
              651.62109375
            ],
            [
              84.4189453125,
              651.62109375
            ]
          ],
          "children": null,
          "section_hierarchy": {
            "1": "/page/40/SectionHeader/1",
