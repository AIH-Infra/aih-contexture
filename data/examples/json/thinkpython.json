        {
          "id": "/page/177/SectionHeader/5",
          "block_type": "SectionHeader",
          "html": "<h3><b>16.7 Exercises</b></h3>",
          "polygon": [
            [
              85.83837890625,
              225.0
            ],
            [
              186.0,
