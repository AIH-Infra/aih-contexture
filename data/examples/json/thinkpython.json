          "images": {}
        },
        {
          "id": "/page/187/Text/4",
          "block_type": "Text",
          "html": "<p><i>The following example creates a 3-D space that is 256 units wide, long and high, and sets the</i> <i>\"center\" to be the point</i> (128, 128, 128)<i>. Then it draws a blue sphere.</i></p>",
          "polygon": [
            [
