          },
          "images": {}
        },
        {
          "id": "/page/27/Text/10",
          "block_type": "Text",
          "html": "<p>This is an example of a <b>print statement</b>, which doesn't actually print anything on paper. It displays a value on the screen. In this case, the result is the words</p>",
          "polygon": [
            [
              84.8671875,
