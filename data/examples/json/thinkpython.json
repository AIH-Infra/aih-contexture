          "images": {}
        },
        {
          "id": "/page/98/Text/6",
          "block_type": "Text",
          "html": "<p>A common way to address this problem is to convert strings to a standard format, such as all lowercase, before performing the comparison. Keep that in mind in case you have to defend yourself against a man armed with a Pineapple.</p>",
          "polygon": [
            [
              129.09375,
