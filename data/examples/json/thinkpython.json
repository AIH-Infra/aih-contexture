            ]
          ],
          "children": null,
          "section_hierarchy": {
            "1": "/page/52/SectionHeader/1",
            "3": "/page/55/SectionHeader/12"
          },
          "images": {}
        },
        {
          "id": "/page/55/Code/14",
          "block_type": "Code",
          "html": "<pre>def square(t, length):\n    for i in range(4):\n        fd(t, length)\n        lt(t)</pre>",
          "polygon": [
            [
              86.0,
              589.0
            ],
            [
              201.8583984375,
              589.0
