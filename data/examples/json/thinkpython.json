          },
          "images": {}
        },
        {
          "id": "/page/63/Text/21",
          "block_type": "Text",
          "html": "<p>'</p>",
          "polygon": [
            [
              139.0,
              536.0
            ],
            [
              144.0,
              536.0
            ],
            [
              144.0,
              546.0
