          "children": null,
          "section_hierarchy": {
            "1": "/page/122/SectionHeader/1",
            "3": "/page/131/SectionHeader/7"
          },
          "images": {}
        },
        {
          "id": "/page/131/SectionHeader/7",
          "block_type": "SectionHeader",
