            "3": "/page/200/SectionHeader/2"
          },
          "images": {}
        },
        {
          "id": "/page/201/Text/7",
          "block_type": "Text",
          "html": "<p><b>Frame:</b> A container, often invisible, that contains other widgets.</p>",
          "polygon": [
            [
              85.68896484375,
