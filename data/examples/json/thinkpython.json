        {
          "id": "/page/104/PageHeader/0",
          "block_type": "PageHeader",
          "html": "<p><b>9.4. Looping with indices 83</b></p>",
          "polygon": [
            [
              127.4501953125,
              61.0
            ],
            [
              526.0,
              61.0
            ],
            [
              526.0,
              71.0
            ],
