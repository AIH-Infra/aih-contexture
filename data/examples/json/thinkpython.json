            "3": "/page/119/SectionHeader/9"
          },
          "images": {}
        },
        {
          "id": "/page/119/Text/17",
          "block_type": "Text",
          "html": "<p><b>Exercise 10.11.</b> <i>To check whether a word is in the word list, you could use the</i> in <i>operator, but it</i> <i>would be slow because it searches through the words in order.</i></p>",
          "polygon": [
            [
