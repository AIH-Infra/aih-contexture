          "images": {}
        },
        {
          "id": "/page/237/Code/4",
          "block_type": "Code",
          "html": "<pre>import copy\nfrom swampy.Lumpy import Lumpy\nlumpy = Lumpy()\nlumpy.make_reference()\nclass Point(object):\n    \"\"\"Represents a point in 2-D space.\"\"\"\nclass Rectangle(object):\n    \"\"\"Represents a rectangle.\"\"\"\ndef instantiate(constructor):\n    \"\"\"Instantiates a new object.\"\"\"\n    obj = constructor()\n    lumpy.object_diagram()\n    return obj</pre>",
          "polygon": [
            [
              86.0,
              272.0
            ],
            [
              306.0,
              272.0
            ],
            [
              306.0,
              477.0
            ],
            [
              86.0,
              477.0
            ]
