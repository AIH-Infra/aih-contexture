            "3": "/page/192/SectionHeader/8"
          },
          "images": {}
        },
        {
          "id": "/page/192/Text/14",
          "block_type": "Text",
          "html": "<p>#inside class Deck:</p>",
          "polygon": [
            [
              129.01904296875,
              613.3359375
            ],
            [
              229.0,
              613.3359375
            ],
            [
