            "3": "/page/63/SectionHeader/12"
          },
          "images": {}
        },
        {
          "id": "/page/63/Code/15",
          "block_type": "Code",
          "html": "<pre>print x is positive</pre>",
          "polygon": [
            [
              103.76806640625,
              547.59375
            ],
            [
              215.75390625,
              547.59375
            ],
            [
              215.75390625,
              559.0
            ],
