          },
          "images": {}
        },
        {
          "id": "/page/188/Text/9",
          "block_type": "Text",
          "html": "<p>Spades 7→ 3 Hearts 7→ 2 Diamonds 7→ 1 Clubs 7→ 0</p>",
          "polygon": [
