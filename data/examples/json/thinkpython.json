        },
        {
          "id": "/page/72/SectionHeader/1",
          "block_type": "SectionHeader",
          "html": "<h1><b>Fruitful functions</b></h1>",
          "polygon": [
            [
              128.42138671875,
              220.81640625
            ],
            [
              332.595703125,
              220.81640625
            ],
            [
              332.595703125,
              248.0
            ],
