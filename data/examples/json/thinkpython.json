        {
          "id": "/page/45/Code/1",
          "block_type": "Code",
          "html": "<pre>&gt;&gt;&gt; print_twice(Spam)\nSpam\nSpam\n&gt;&gt;&gt; print_twice(17)\n17\n17\n&gt;&gt;&gt; print_twice(math.pi)\n3.14159265359\n3.14159265359</pre>",
          "polygon": [
            [
              86.0,
