        {
          "id": "/page/95/PageHeader/19",
          "block_type": "PageHeader",
          "html": "<p></p>",
          "polygon": [
            [
              85.24072265625,
              60.521484375
            ],
            [
              95.69970703125,
              60.521484375
            ],
            [
