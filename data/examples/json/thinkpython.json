          },
          "images": {}
        },
        {
          "id": "/page/131/ListGroup/175",
          "block_type": "ListGroup",
          "html": "<p><ul><content-ref src='/page/131/ListItem/9'></content-ref><content-ref src='/page/131/ListItem/10'></content-ref><content-ref src='/page/131/ListItem/11'></content-ref><content-ref src='/page/131/ListItem/12'></content-ref><content-ref src='/page/131/ListItem/13'></content-ref><content-ref src='/page/131/ListItem/14'></content-ref><content-ref src='/page/131/ListItem/15'></content-ref><content-ref src='/page/131/ListItem/16'></content-ref><content-ref src='/page/131/ListItem/17'></content-ref><content-ref src='/page/131/ListItem/18'></content-ref><content-ref src='/page/131/ListItem/19'></content-ref><content-ref src='/page/131/ListItem/20'></content-ref><content-ref src='/page/131/ListItem/21'></content-ref></ul></p>",
          "polygon": [
            [
              84.7177734375,
              378.59765625
            ],
            [
              483.50390625,
              378.59765625
            ],
            [
