          ],
          "children": null,
          "section_hierarchy": {
            "1": "/page/232/SectionHeader/1",
            "3": "/page/236/SectionHeader/9",
            "4": "/page/237/SectionHeader/5"
          },
          "images": {}
        },
        {
          "id": "/page/237/Text/7",
          "block_type": "Text",
          "html": "<p>At the module level, Point and Rectangle refer to class objects (which have type type); instantiate refers to a function object.</p>",
          "polygon": [
