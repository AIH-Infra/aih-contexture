          },
          "images": {}
        },
        {
          "id": "/page/132/Text/8",
          "block_type": "Text",
          "html": "<p><i>Write a program that reads a wordlist and finds all the rotate pairs. Solution:</i> http: // thinkpython. com/ code/ rotate_ pairs. py .</p>",
          "polygon": [
            [
              129.69140625,
