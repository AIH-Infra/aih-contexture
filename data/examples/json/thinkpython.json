            "3": "/page/38/SectionHeader/10"
          },
          "images": {}
        },
        {
          "id": "/page/38/Text/11",
          "block_type": "Text",
          "html": "<p><b>value:</b> One of the basic units of data, like a number or string, that a program manipulates.</p>",
