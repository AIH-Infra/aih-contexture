          },
          "images": {}
        },
        {
          "id": "/page/25/PageHeader/14",
          "block_type": "PageHeader",
          "html": "<p></p>",
          "polygon": [
            [
              84.04541015625,
              59.5546875
            ],
            [
              91.51611328125,
              59.5546875
            ],
            [
