        {
          "id": "/page/125/Text/4",
          "block_type": "Text",
          "html": "<p><i>Modify</i> print_hist <i>to print the keys and their values in alphabetical order.</i></p>",
          "polygon": [
            [
              85.46484375,
              281.91796875
            ],
            [
              391.0,
              281.91796875
            ],
            [
              391.0,
              293.0
            ],
            [
              85.46484375,
