        },
        {
          "id": "/page/112/Text/12",
          "block_type": "Text",
          "html": "<p><b>Exercise 10.1.</b> <i>Write a function called</i> nested_sum <i>that takes a nested list of integers and add up</i> <i>the elements from all of the nested lists.</i></p>",
          "polygon": [
            [
              129.09375,
