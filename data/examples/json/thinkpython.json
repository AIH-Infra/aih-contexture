            "3": "/page/153/SectionHeader/7"
          },
          "images": {}
        },
        {
          "id": "/page/153/TextInlineMath/12",
          "block_type": "TextInlineMath",
          "html": "<p>log f = log c − slog r</p>",
          "polygon": [
            [
              237.568359375,
              443.0
            ],
            [
              330.802734375,
              443.0
            ],
            [
              330.802734375,
              454.39453125
            ],
            [
              237.568359375,
              454.39453125
            ]
          ],
          "children": null,
          "section_hierarchy": {
            "1": "/page/144/SectionHeader/1",
            "3": "/page/153/SectionHeader/7"
          },
          "images": {}
        },
        {
          "id": "/page/153/TextInlineMath/13",
          "block_type": "TextInlineMath",
          "html": "<p><i>So if you plot log f versus log r, you should get a straight line with slope</i> −<i>s and intercept log c.</i></p>",
          "polygon": [
            [
              85.3154296875,
              462.0
