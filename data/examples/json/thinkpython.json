          },
          "images": {}
        },
        {
          "id": "/page/55/Text/16",
          "block_type": "Text",
          "html": "<p>Adding a parameter to a function is called <b>generalization</b> because it makes the function more general: in the previous version, the square is always the same size; in this version it can be any size.</p>",
          "polygon": [
            [
              85.763671875,
              664.76953125
            ],
            [
              483.205078125,
              664.76953125
            ],
            [
              483.205078125,
              701.0
            ],
            [
              85.763671875,
              701.0
            ]
          ],
          "children": null,
          "section_hierarchy": {
            "1": "/page/52/SectionHeader/1",
            "3": "/page/55/SectionHeader/12"
          },
          "images": {}
        }
