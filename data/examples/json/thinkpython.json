          },
          "images": {}
        },
        {
          "id": "/page/160/SectionHeader/10",
          "block_type": "SectionHeader",
          "html": "<h3><b>14.9 Writing modules</b></h3>",
          "polygon": [
            [
              128.49609375,
              563.8359375
            ],
            [
              279.0,
              563.8359375
            ],
            [
              279.0,
              579.0
            ],
            [
              128.49609375,
              579.0
            ]
          ],
          "children": null,
          "section_hierarchy": {
            "1": "/page/154/SectionHeader/1",
            "3": "/page/160/SectionHeader/10"
          },
          "images": {}
        },
        {
          "id": "/page/160/Text/11",
          "block_type": "Text",
          "html": "<p>Any file that contains Python code can be imported as a module. For example, suppose you have a file named wc.py with the following code:</p>",
          "polygon": [
            [
              128.49609375,
              588.97265625
            ],
            [
              527.1328125,
              588.97265625
            ],
            [
              527.1328125,
              612.17578125
            ],
            [
              128.49609375,
              612.17578125
            ]
          ],
          "children": null,
          "section_hierarchy": {
            "1": "/page/154/SectionHeader/1",
            "3": "/page/160/SectionHeader/10"
          },
          "images": {}
        },
        {
          "id": "/page/160/Code/12",
          "block_type": "Code",
          "html": "<pre>def linecount(filename):\n    count = 0\n    for line in open(filename):\n        count += 1\n    return count\n                ''</pre>",
          "polygon": [
            [
              127.07666015625,
              618.0
            ],
            [
              292.0,
              618.0
            ],
            [
              292.0,
              687.0
            ],
            [
              127.07666015625,
              687.0
            ]
          ],
          "children": null,
          "section_hierarchy": {
            "1": "/page/154/SectionHeader/1",
            "3": "/page/160/SectionHeader/10"
          },
          "images": {}
        },
        {
          "id": "/page/160/Text/13",
          "block_type": "Text",
          "html": "<p class=\"has-continuation\">print linecount(wc.py)</p>",
          "polygon": [
            [
              128.72021484375,
              691.0
            ],
            [
              255.0,
              691.0
            ],
            [
              255.0,
