    {
      "id": "/page/76/Page/228",
      "block_type": "Page",
      "html": "<content-ref src='/page/76/PageHeader/0'></content-ref><content-ref src='/page/76/PageHeader/16'></content-ref><content-ref src='/page/76/Text/1'></content-ref><content-ref src='/page/76/Code/2'></content-ref><content-ref src='/page/76/Text/3'></content-ref><content-ref src='/page/76/Code/4'></content-ref><content-ref src='/page/76/Text/5'></content-ref><content-ref src='/page/76/Code/6'></content-ref><content-ref src='/page/76/Text/7'></content-ref><content-ref src='/page/76/Text/8'></content-ref><content-ref src='/page/76/Text/17'></content-ref><content-ref src='/page/76/SectionHeader/9'></content-ref><content-ref src='/page/76/Text/10'></content-ref><content-ref src='/page/76/Text/11'></content-ref><content-ref src='/page/76/Text/12'></content-ref><content-ref src='/page/76/Text/13'></content-ref><content-ref src='/page/76/Text/14'></content-ref><content-ref src='/page/76/TextInlineMath/15'></content-ref>",
      "polygon": [
        [
          0.0,
          0.0
        ],
        [
          612.0,
