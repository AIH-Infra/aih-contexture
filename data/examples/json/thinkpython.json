        {
          "id": "/page/209/Text/3",
          "block_type": "Text",
          "html": "<p>This computation is done in pixel coordinates; there is no need to convert to Canvas coordinates.</p>",
          "polygon": [
            [
              85.763671875,
              164.6455078125
            ],
            [
              483.205078125,
