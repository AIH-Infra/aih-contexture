          "children": null,
          "section_hierarchy": {
            "1": "/page/32/SectionHeader/1",
            "3": "/page/37/SectionHeader/6"
          },
          "images": {}
        },
        {
          "id": "/page/37/TextInlineMath/15",
          "block_type": "TextInlineMath",
          "html": "<p>v = 5 # assign 5 to v</p>",
          "polygon": [
            [
              85.166015625,
              544.5
            ],
            [
              217.546875,
              544.5
            ],
            [
              217.546875,
              556.0
            ],
            [
              85.166015625,
