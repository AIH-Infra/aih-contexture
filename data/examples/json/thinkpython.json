            [
              86.0,
              649.0
            ]
          ],
          "children": null,
          "section_hierarchy": {
            "1": "/page/40/SectionHeader/1",
            "3": "/page/43/SectionHeader/12"
          },
          "images": {}
        },
        {
          "id": "/page/43/Text/16",
          "block_type": "Text",
          "html": "<p>This program contains two function definitions: print_lyrics and repeat_lyrics. Function definitions get executed just like other statements, but the effect is to create function objects. The statements inside the function do not get executed until the function is called, and the function definition generates no output.</p>",
          "polygon": [
