        {
          "id": "/page/139/SectionHeader/13",
          "block_type": "SectionHeader",
          "html": "<h3><b>12.7 Comparing tuples</b></h3>",
          "polygon": [
            [
              85.9130859375,
              524.390625
            ],
            [
              244.8896484375,
              524.390625
            ],
            [
              244.8896484375,
