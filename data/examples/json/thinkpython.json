          "images": {}
        },
        {
          "id": "/page/119/Text/16",
          "block_type": "Text",
          "html": "<p><i>Hint: use the</i> time <i>module to measure elapsed time. Solution:</i> http: // thinkpython. com/ code/ wordlist. py .</p>",
          "polygon": [
            [
              85.9130859375,
