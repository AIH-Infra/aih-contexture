          },
          "images": {}
        },
        {
          "id": "/page/155/Code/9",
          "block_type": "Code",
          "html": "<pre>&gt;&gt;&gt; camels = 42\n&gt;&gt;&gt; '%d' % camels\n'42'</pre>",
          "polygon": [
