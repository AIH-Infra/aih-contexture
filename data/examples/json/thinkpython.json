        },
        {
          "id": "/page/202/Text/2",
          "block_type": "Text",
          "html": "<p>When you press this button, it should execute make_label and a new label should appear.</p>",
          "polygon": [
            [
              129.392578125,
              102.5771484375
            ],
            [
              523.248046875,
              102.5771484375
            ],
            [
              523.248046875,
              113.0
            ],
