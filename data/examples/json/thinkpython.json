          },
          "images": {}
        },
        {
          "id": "/page/138/Code/5",
          "block_type": "Code",
          "html": "<pre>&gt;&gt;&gt; d = {a:0, b:1, c:2}\n&gt;&gt;&gt; t = d.items()\n&gt;&gt;&gt; print t\n[('a', 0), ('c', 2), ('b', 1)]</pre>",
          "polygon": [
            [
