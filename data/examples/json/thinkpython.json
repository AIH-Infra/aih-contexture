                "3": "/page/223/SectionHeader/5"
              },
              "images": {}
            },
            {
              "id": "/page/224/ListItem/9",
              "block_type": "ListItem",
              "html": "<li><i>3. If f is in O</i>(g)<i>, for some unspecified function g, what can we say about a f</i> + b?</li>",
              "polygon": [
                [
                  141.943359375,
                  495.0
                ],
                [
                  474.0,
                  495.0
                ],
                [
                  474.0,
                  506.0
                ],
                [
                  141.943359375,
                  506.0
                ]
              ],
              "children": null,
              "section_hierarchy": {
                "1": "/page/222/SectionHeader/1",
                "3": "/page/223/SectionHeader/5"
              },
              "images": {}
            },
            {
              "id": "/page/224/ListItem/10",
              "block_type": "ListItem",
              "html": "<li><i>4. If f</i>1 <i>and f</i>2 <i>are in O</i>(g)<i>, what can we say about f</i>1 + f2?</li>",
              "polygon": [
                [
                  142.0,
                  517.0
                ],
                [
                  383.09765625,
                  517.0
                ],
                [
                  383.09765625,
                  529.0
                ],
                [
                  142.0,
                  529.0
                ]
              ],
              "children": null,
              "section_hierarchy": {
                "1": "/page/222/SectionHeader/1",
                "3": "/page/223/SectionHeader/5"
              },
              "images": {}
            },
            {
              "id": "/page/224/ListItem/11",
              "block_type": "ListItem",
              "html": "<li><i>5. If f</i>1 <i>is in O</i>(g) <i>and f</i>2 <i>is in O</i>(h)<i>, what can we say about f</i>1 + f2?</li>",
              "polygon": [
                [
                  141.56982421875,
                  537.92578125
                ],
                [
                  422.0,
                  537.92578125
                ],
                [
                  422.0,
                  550.0
                ],
                [
                  141.56982421875,
                  550.0
                ]
              ],
              "children": null,
              "section_hierarchy": {
                "1": "/page/222/SectionHeader/1",
                "3": "/page/223/SectionHeader/5"
              },
              "images": {}
            },
            {
              "id": "/page/224/ListItem/12",
              "block_type": "ListItem",
              "html": "<li><i>6. If f</i>1 <i>is in O</i>(g) <i>and f</i>2 <i>is O</i>(h)<i>, what can we say about f</i>1 · f2?</li>",
              "polygon": [
                [
                  141.86865234375,
                  559.0
                ],
                [
                  406.0,
                  559.0
                ],
                [
                  406.0,
                  571.0
                ],
                [
                  141.86865234375,
                  571.0
                ]
              ],
              "children": null,
              "section_hierarchy": {
                "1": "/page/222/SectionHeader/1",
                "3": "/page/223/SectionHeader/5"
              },
              "images": {}
            }
          ],
          "section_hierarchy": {
            "1": "/page/222/SectionHeader/1",
            "3": "/page/223/SectionHeader/5"
          },
          "images": null
        },
        {
          "id": "/page/224/Text/13",
          "block_type": "Text",
          "html": "<p>Programmers who care about performance often find this kind of analysis hard to swallow. They have a point: sometimes the coefficients and the non-leading terms make a real difference. Sometimes the details of the hardware, the programming language, and the characteristics of the input make a big difference. And for small problems asymptotic behavior is irrelevant.</p>",
          "polygon": [
            [
              129.09375,
              584.33203125
            ],
            [
              526.53515625,
              584.33203125
            ],
            [
              526.53515625,
              644.0
            ],
            [
              129.09375,
              644.0
            ]
          ],
          "children": null,
          "section_hierarchy": {
            "1": "/page/222/SectionHeader/1",
            "3": "/page/223/SectionHeader/5"
          },
          "images": {}
        },
        {
          "id": "/page/224/Text/14",
          "block_type": "Text",
          "html": "<p>But if you keep those caveats in mind, algorithmic analysis is a useful tool. At least for large problems, the \"better\" algorithms is usually better, and sometimes it is <i>much</i> better. The difference between two algorithms with the same order of growth is usually a constant factor, but the difference between a good algorithm and a bad algorithm is unbounded!</p>",
          "polygon": [
            [
              129.2431640625,
              654.0
            ],
            [
              526.53515625,
              652.78125
            ],
            [
              526.53515625,
              701.0
            ],
            [
              129.2431640625,
              702.28125
            ]
          ],
          "children": null,
          "section_hierarchy": {
            "1": "/page/222/SectionHeader/1",
            "3": "/page/223/SectionHeader/5"
          },
          "images": {}
        }
      ],
      "section_hierarchy": {
        "1": "/page/222/SectionHeader/1",
        "3": "/page/223/SectionHeader/5"
