            ]
          ],
          "children": null,
          "section_hierarchy": {
            "1": "/page/164/SectionHeader/1",
            "3": "/page/166/SectionHeader/7"
          },
          "images": {}
        },
        {
          "id": "/page/166/Text/17",
          "block_type": "Text",
          "html": "<p>box = Rectangle() box.width = 100.0 box.height = 200.0</p>",
