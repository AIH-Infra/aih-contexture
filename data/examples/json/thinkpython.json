          },
          "images": {}
        },
        {
          "id": "/page/118/Table/6",
          "block_type": "Table",
          "html": "<table>\n<thead>\n<tr><th>t.append([x])  </th><th># WRONG!  </th></tr>\n</thead>\n<tbody>\n<tr><td>t = t.append(x)</td><td># WRONG!  </td></tr>\n<tr><td>t + [x]        </td><td># WRONG!  </td></tr>\n<tr><td>t = t + x      </td><td># WRONG!  </td></tr>\n</tbody>\n</table>",
          "polygon": [
