          "children": null,
          "section_hierarchy": {
            "1": "/page/188/SectionHeader/1",
            "3": "/page/192/SectionHeader/8"
          },
          "images": {}
        },
        {
          "id": "/page/192/Text/11",
          "block_type": "Text",
          "html": "<p>def pop_card(self): return self.cards.pop()</p>",
          "polygon": [
            [
              150.609375,
              536.0
            ],
            [
              292.0,
              536.0
            ],
