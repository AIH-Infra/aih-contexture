          "children": null,
          "section_hierarchy": {
            "1": "/page/164/SectionHeader/1",
            "3": "/page/166/SectionHeader/7"
          },
          "images": {}
        },
        {
          "id": "/page/166/Code/14",
          "block_type": "Code",
          "html": "<pre>class Rectangle(object):\n    \"\"\"Represents a rectangle.\n    attributes: width, height, corner.\n    \"\"\"</pre>",
          "polygon": [
            [
              130.0,
              540.6328125
            ],
            [
              328.0,
              540.6328125
            ],
            [
              328.0,
              600.0
            ],
            [
              130.0,
              600.0
            ]
          ],
          "children": null,
          "section_hierarchy": {
            "1": "/page/164/SectionHeader/1",
            "3": "/page/166/SectionHeader/7"
          },
          "images": {}
        },
        {
          "id": "/page/166/Text/15",
          "block_type": "Text",
          "html": "<p>The docstring lists the attributes: width and height are numbers; corner is a Point object that specifies the lower-left corner.</p>",
          "polygon": [
            [
              128.9443359375,
              605.6015625
            ],
