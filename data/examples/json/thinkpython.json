                "3": "/page/59/SectionHeader/9"
              },
              "images": {}
            },
            {
              "id": "/page/59/ListItem/12",
              "block_type": "ListItem",
              "html": "<li><b>encapsulation:</b> The process of transforming a sequence of statements into a function definition.</li>",
              "polygon": [
                [
                  85.763671875,
                  548.3671875
                ],
                [
                  483.50390625,
                  548.3671875
                ],
                [
