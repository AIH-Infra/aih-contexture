          },
          "images": {}
        },
        {
          "id": "/page/65/TextInlineMath/5",
          "block_type": "TextInlineMath",
          "html": "<p>if 0 &lt; x: if x &lt; 10: print 'x is a positive single-digit number.'</p>",
          "polygon": [
