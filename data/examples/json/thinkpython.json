        {
          "id": "/page/189/Text/10",
          "block_type": "Text",
          "html": "<p># inside class Card:</p>",
          "polygon": [
            [
              84.49365234375,
              445.88671875
            ],
            [
              191.25,
              445.88671875
            ],
