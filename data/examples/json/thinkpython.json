        },
        {
          "id": "/page/212/Text/7",
          "block_type": "Text",
          "html": "<p><i>At a minimum your browser should handle plain text and hyperlinks. As a challenge you could</i> <i>handle background colors, text formatting tags and images.</i></p>",
          "polygon": [
            [
