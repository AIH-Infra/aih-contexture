            "3": "/page/192/SectionHeader/8"
          },
          "images": {}
        },
        {
          "id": "/page/192/SectionHeader/8",
          "block_type": "SectionHeader",
          "html": "<h3><b>18.6 Add, remove, shuffle and sort</b></h3>",
          "polygon": [
