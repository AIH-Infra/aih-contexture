            "3": "/page/113/SectionHeader/6"
          },
          "images": {}
        },
        {
          "id": "/page/113/Text/12",
          "block_type": "Text",
          "html": "<p>The return value from remove is None.</p>",
          "polygon": [
            [
              86.0,
