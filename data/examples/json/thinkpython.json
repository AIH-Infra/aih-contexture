          "images": {}
        },
        {
          "id": "/page/112/TextInlineMath/10",
          "block_type": "TextInlineMath",
          "html": "<p>&gt;&gt;&gt; t = [1, 2, 3] &gt;&gt;&gt; sum(t) 6</p>",
