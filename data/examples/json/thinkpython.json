          },
          "images": {}
        },
        {
          "id": "/page/137/Code/9",
          "block_type": "Code",
          "html": "<pre>t = [(a, 0), (b, 1), (c, 2)]\nfor letter, number in t:\n    print number, letter</pre>",
          "polygon": [
