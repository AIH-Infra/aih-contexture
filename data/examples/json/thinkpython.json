            "3": "/page/209/SectionHeader/9"
          },
          "images": {}
        },
        {
          "id": "/page/209/SectionHeader/9",
          "block_type": "SectionHeader",
          "html": "<h3><b>19.9 Debugging</b></h3>",
          "polygon": [
            [
              85.6142578125,
              398.3203125
            ],
            [
              200.6630859375,
              398.3203125
            ],
            [
              200.6630859375,
              415.0
