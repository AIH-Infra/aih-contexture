        },
        {
          "id": "/page/155/Text/7",
          "block_type": "Text",
          "html": "<p>The first operand is the <b>format string</b>, which contains one or more <b>format sequences</b>, which specify how the second operand is formatted. The result is a string. ''</p>",
          "polygon": [
            [
              85.6142578125,
              342.052734375
            ],
