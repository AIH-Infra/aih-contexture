          "children": null,
          "section_hierarchy": {
            "1": "/page/134/SectionHeader/1",
            "3": "/page/138/SectionHeader/3",
            "4": "/page/139/SectionHeader/3"
          },
          "images": {}
        },
        {
          "id": "/page/139/Text/10",
          "block_type": "Text",
          "html": "<p>But in a larger diagram you might want to leave out the details. For example, a diagram of the telephone directory might appear as in Figure 12.2.</p>",
          "polygon": [
