            "3": "/page/192/SectionHeader/8"
          },
          "images": {}
        },
        {
          "id": "/page/192/Text/12",
          "block_type": "Text",
          "html": "<p>Since pop removes the <i>last</i> card in the list, we are dealing from the bottom of the deck. In real life \"bottom dealing\" is frowned upon, but in this context it's ok.</p>",
          "polygon": [
            [
              128.794921875,
              565.0
            ],
            [
              526.236328125,
              565.0
            ],
            [
              526.236328125,
              587.0390625
            ],
            [
              128.794921875,
              587.0390625
            ]
          ],
          "children": null,
          "section_hierarchy": {
            "1": "/page/188/SectionHeader/1",
            "3": "/page/192/SectionHeader/8"
          },
          "images": {}
        },
        {
          "id": "/page/192/Text/13",
          "block_type": "Text",
          "html": "<p>To add a card, we can use the list method append:</p>",
          "polygon": [
            [
              128.9443359375,
              597.0
            ],
            [
              347.0,
              597.0
            ],
            [
              347.0,
