        {
          "id": "/page/79/Code/12",
          "block_type": "Code",
          "html": "<pre>&gt;&gt;&gt; factorial(fred)\nFactorial is only defined for integers.\nNone\n&gt;&gt;&gt; factorial(-2)\nFactorial is not defined for negative integers.\nNone</pre>",
          "polygon": [
