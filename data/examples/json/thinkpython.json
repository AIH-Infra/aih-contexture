                ]
              ],
              "children": null,
              "section_hierarchy": {
                "1": "/page/40/SectionHeader/1",
                "3": "/page/47/SectionHeader/17"
              },
              "images": {}
            }
          ],
          "section_hierarchy": {
            "1": "/page/40/SectionHeader/1",
            "3": "/page/47/SectionHeader/17"
          },
          "images": null
        }
      ],
      "section_hierarchy": {
        "1": "/page/40/SectionHeader/1",
        "3": "/page/47/SectionHeader/17"
