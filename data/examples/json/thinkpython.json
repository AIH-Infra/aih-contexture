        },
        {
          "id": "/page/105/PageHeader/8",
          "block_type": "PageHeader",
          "html": "<p></p>",
          "polygon": [
            [
              84.94189453125,
              60.71484375
            ],
            [
              95.69970703125,
              60.71484375
            ],
            [
              95.69970703125,
              69.99609375
            ],
            [
              84.94189453125,
              69.99609375
