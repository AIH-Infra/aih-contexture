            "3": "/page/142/SectionHeader/9"
          },
          "images": {}
        },
        {
          "id": "/page/143/Text/2",
          "block_type": "Text",
          "html": "<p><b>Exercise 12.6.</b> <i>Here's another Car Talk Puzzler (</i>http: // www. cartalk. com/ content/ puzzlers ):</p>",
          "polygon": [
