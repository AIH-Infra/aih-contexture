        },
        {
          "id": "/page/30/Text/2",
          "block_type": "Text",
          "html": "<p><b>Exercise 1.2.</b> <i>Use a web browser to go to the Python website</i> http: // python. org <i>. This page</i> <i>contains information about Python and links to Python-related pages, and it gives you the ability to</i> <i>search the Python documentation.</i></p>",
          "polygon": [
            [
              128.0478515625,
              111.375
            ],
            [
              526.0,
