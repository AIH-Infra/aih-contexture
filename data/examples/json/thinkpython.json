          "children": null,
          "section_hierarchy": {
            "1": "/page/144/SectionHeader/1",
            "3": "/page/149/SectionHeader/11"
          },
          "images": {}
        },
        {
          "id": "/page/150/ListItem/11",
          "block_type": "ListItem",
          "html": "<li><i>3. Once your program is working, you might want to try a mash-up: if you analyze text from</i> <i>two or more books, the random text you generate will blend the vocabulary and phrases from</i> <i>the sources in interesting ways.</i></li>",
          "polygon": [
            [
              141.345703125,
              473.34375
            ],
            [
              526.833984375,
              473.34375
            ],
            [
              526.833984375,
              508.1484375
            ],
            [
              141.345703125,
              508.1484375
            ]
