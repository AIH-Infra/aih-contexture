          "children": null,
          "section_hierarchy": {
            "1": "/page/164/SectionHeader/1",
            "3": "/page/170/SectionHeader/2"
          },
          "images": {}
        },
        {
          "id": "/page/170/ListItem/4",
          "block_type": "ListItem",
          "html": "<li><b>class object:</b> An object that contains information about a user-defined type. The class object can be used to create instances of the type.</li>",
          "polygon": [
            [
              129.2431640625,
              181.0
            ],
            [
              526.0,
              181.0
            ],
            [
              526.0,
              203.0
            ],
            [
              129.2431640625,
              203.0
            ]
          ],
          "children": null,
          "section_hierarchy": {
            "1": "/page/164/SectionHeader/1",
            "3": "/page/170/SectionHeader/2"
          },
          "images": {}
        },
        {
          "id": "/page/170/Text/5",
          "block_type": "Text",
          "html": "<p><b>instance:</b> An object that belongs to a class.</p>",
          "polygon": [
            [
              128.72021484375,
              212.0
            ],
            [
              317.35546875,
              212.0
