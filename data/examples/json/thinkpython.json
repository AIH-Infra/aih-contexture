            {
              "id": "/page/169/Caption/2",
              "block_type": "Caption",
              "html": "<p>Figure 15.3: Object diagram.</p>",
              "polygon": [
                [
                  221.5810546875,
                  147.533203125
                ],
                [
                  347.23828125,
                  147.533203125
                ],
                [
                  347.23828125,
