          },
          "images": {}
        },
        {
          "id": "/page/166/Text/13",
          "block_type": "Text",
          "html": "<p>Here is the class definition:</p>",
          "polygon": [
            [
              127.599609375,
              524.00390625
            ],
            [
              249.521484375,
              524.00390625
            ],
            [
              249.521484375,
              535.0
