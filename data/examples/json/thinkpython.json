          "children": null,
          "section_hierarchy": {
            "1": "/page/164/SectionHeader/1",
            "3": "/page/165/SectionHeader/9"
          },
          "images": {}
        },
        {
          "id": "/page/166/Text/3",
          "block_type": "Text",
          "html": "<p>def print_point(p): print '(%g, %g)'% (p.x, p.y)</p>",
          "polygon": [
            [
              130.0,
              168.0
            ],
            [
              302.0,
              168.0
            ],
            [
              302.0,
              192.0
            ],
            [
              130.0,
              192.0
            ]
          ],
          "children": null,
          "section_hierarchy": {
            "1": "/page/164/SectionHeader/1",
            "3": "/page/165/SectionHeader/9"
          },
          "images": {}
        },
        {
          "id": "/page/166/Text/4",
          "block_type": "Text",
          "html": "<p>print_point takes a point as an argument and displays it in mathematical notation. To invoke it, you can pass blank as an argument:</p>",
          "polygon": [
            [
              128.49609375,
              196.83984375
            ],
            [
              526.53515625,
              196.83984375
            ],
            [
