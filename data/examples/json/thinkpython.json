          "children": null,
          "section_hierarchy": {
            "1": "/page/188/SectionHeader/1",
            "3": "/page/192/SectionHeader/8"
          },
          "images": {}
        },
        {
          "id": "/page/192/Text/15",
          "block_type": "Text",
          "html": "<p>def add_card(self, card): self.cards.append(card)</p>",
          "polygon": [
            [
              150.83349609375,
              638.0
            ],
            [
              292.0,
              638.0
