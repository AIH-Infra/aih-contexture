      "children": [
        {
          "id": "/page/136/PageHeader/0",
          "block_type": "PageHeader",
          "html": "<p><b>12.3. Tuples as return values 115</b></p>",
          "polygon": [
            [
              128.197265625,
              61.0
            ],
            [
              526.0,
              61.0
            ],
            [
              526.0,
