          "children": null,
          "section_hierarchy": {
            "1": "/page/200/SectionHeader/1",
            "3": "/page/207/SectionHeader/9"
          },
          "images": {}
        },
        {
          "id": "/page/209/Text/4",
          "block_type": "Text",
          "html": "<p>Finally, drop restores the original color of the item:</p>",
          "polygon": [
            [
              85.39013671875,
