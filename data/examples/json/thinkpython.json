          "children": null,
          "section_hierarchy": {
            "1": "/page/200/SectionHeader/1",
            "3": "/page/200/SectionHeader/2"
          },
          "images": {}
        },
        {
          "id": "/page/201/Text/3",
          "block_type": "Text",
          "html": "<p><b>Button:</b> A widget, containing text or an image, that performs an action when pressed.</p>",
          "polygon": [
            [
              85.46484375,
              156.62109375
            ],
            [
              465.0,
              156.62109375
            ],
            [
              465.0,
              168.0
            ],
            [
              85.46484375,
              168.0
            ]
