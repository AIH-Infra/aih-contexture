              "images": {}
            },
            {
              "id": "/page/131/ListItem/14",
              "block_type": "ListItem",
              "html": "<li><b>hashtable:</b> The algorithm used to implement Python dictionaries.</li>",
              "polygon": [
                [
                  84.79248046875,
