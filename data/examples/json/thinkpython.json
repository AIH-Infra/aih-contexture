          },
          "images": {}
        },
        {
          "id": "/page/69/Text/1",
          "block_type": "Text",
          "html": "<p>The same is true of runtime errors.</p>",
          "polygon": [
            [
              86.0,
              89.0
            ],
            [
              238.0,
              89.0
            ],
            [
              238.0,
              99.2900390625
