            "3": "/page/104/SectionHeader/15"
          },
          "images": {}
        },
        {
          "id": "/page/104/SectionHeader/15",
          "block_type": "SectionHeader",
          "html": "<h3><b>9.4 Looping with indices</b></h3>",
          "polygon": [
