          ],
          "children": null,
          "section_hierarchy": {
            "1": "/page/122/SectionHeader/1",
            "3": "/page/129/SectionHeader/1"
          },
          "images": {}
        },
        {
          "id": "/page/130/TextInlineMath/1",
          "block_type": "TextInlineMath",
          "html": "<p>known = {0:0, 1:1} def example4(): known[2] = 1</p>",
          "polygon": [
            [
              128.0478515625,
              89.0
            ],
            [
              224.0,
              89.0
            ],
            [
              224.0,
              135.0
            ],
            [
              128.0478515625,
              135.0
            ]
          ],
          "children": null,
          "section_hierarchy": {
            "1": "/page/122/SectionHeader/1",
            "3": "/page/129/SectionHeader/1"
          },
          "images": {}
        },
        {
          "id": "/page/130/Text/2",
          "block_type": "Text",
          "html": "<p>So you can add, remove and replace elements of a global list or dictionary, but if you want to reassign the variable, you have to declare it:</p>",
          "polygon": [
            [
              129.2431640625,
              140.572265625
            ],
            [
              526.53515625,
              140.572265625
            ],
            [
              526.53515625,
              164.35546875
            ],
            [
              129.2431640625,
              164.35546875
            ]
          ],
          "children": null,
          "section_hierarchy": {
            "1": "/page/122/SectionHeader/1",
            "3": "/page/129/SectionHeader/1"
          },
          "images": {}
        },
        {
          "id": "/page/130/Code/3",
          "block_type": "Code",
          "html": "<pre>def example5():\n    global known\n    known = dict()</pre>",
          "polygon": [
            [
              129.31787109375,
              170.0
            ],
            [
              224.0,
              170.0
            ],
            [
              224.0,
              206.701171875
            ],
            [
              129.31787109375,
              206.701171875
            ]
          ],
          "children": null,
          "section_hierarchy": {
            "1": "/page/122/SectionHeader/1",
