            "3": "/page/119/SectionHeader/9"
          },
          "images": {}
        },
        {
          "id": "/page/119/Text/18",
          "block_type": "Text",
          "html": "<p class=\"has-continuation\"><i>Because the words are in alphabetical order, we can speed things up with a bisection search (also</i> <i>known as binary search), which is similar to what you do when you look a word up in the dictionary.</i></p>",
          "polygon": [
            [
              85.166015625,
