        {
          "id": "/page/86/ListGroup/230",
          "block_type": "ListGroup",
          "html": "<p><ul><content-ref src='/page/86/ListItem/1'></content-ref><content-ref src='/page/86/ListItem/2'></content-ref></ul></p>",
          "polygon": [
            [
              141.345703125,
