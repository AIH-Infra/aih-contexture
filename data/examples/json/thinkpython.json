          "children": null,
          "section_hierarchy": {
            "1": "/page/92/SectionHeader/1",
            "3": "/page/96/SectionHeader/1"
          },
          "images": {}
        },
        {
          "id": "/page/96/Text/4",
          "block_type": "Text",
          "html": "<p>This program demonstrates another pattern of computation called a <b>counter</b>. The variable count is initialized to 0 and then incremented each time an a is found. When the loop exits, count contains the result—the total number of a's.</p>",
          "polygon": [
            [
              128.49609375,
              205.34765625
