          "children": null,
          "section_hierarchy": {
            "1": "/page/40/SectionHeader/1",
            "3": "/page/43/SectionHeader/12"
          },
          "images": {}
        },
        {
          "id": "/page/43/Code/14",
          "block_type": "Code",
          "html": "<pre>def print_lyrics():\n    print \"I'm a lumberjack, and I'm okay.\"\n    print \"I sleep all night and I work all day.\"\ndef repeat_lyrics():\n    print_lyrics()\n    print_lyrics()</pre>",
          "polygon": [
            [
              85.83837890625,
              539.859375
            ],
            [
              343.951171875,
              539.859375
            ],
            [
              343.951171875,
              624.0
            ],
            [
              85.83837890625,
              624.0
            ]
