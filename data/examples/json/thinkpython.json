                ]
              ],
              "children": null,
              "section_hierarchy": {
                "1": "/page/164/SectionHeader/1",
                "3": "/page/166/SectionHeader/7"
              },
              "images": {}
            }
          ],
          "section_hierarchy": {
            "1": "/page/164/SectionHeader/1",
            "3": "/page/166/SectionHeader/7"
          },
          "images": null
        },
        {
          "id": "/page/166/Text/12",
          "block_type": "Text",
          "html": "<p>At this point it is hard to say whether either is better than the other, so we'll implement the first one, just as an example.</p>",
          "polygon": [
            [
              128.6455078125,
              492.29296875
            ],
