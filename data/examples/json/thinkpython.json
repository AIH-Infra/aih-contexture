          "children": null,
          "section_hierarchy": {
            "1": "/page/200/SectionHeader/1",
            "3": "/page/209/SectionHeader/9"
          },
          "images": {}
        },
        {
          "id": "/page/209/Text/11",
          "block_type": "Text",
          "html": "<p>For example, when you are setting up a callback, it is a common error to call the function rather than passing a reference to it:</p>",
          "polygon": [
