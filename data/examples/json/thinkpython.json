            "3": "/page/38/SectionHeader/10"
          },
          "images": {}
        },
        {
          "id": "/page/38/ListItem/12",
          "block_type": "ListItem",
          "html": "<li><b>type:</b> A category of values. The types we have seen so far are integers (type int), floatingpoint numbers (type float), and strings (type str).</li>",
