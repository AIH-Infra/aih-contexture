              596.0
            ]
          ],
          "children": null,
          "section_hierarchy": {
            "1": "/page/22/SectionHeader/1",
            "3": "/page/27/SectionHeader/7"
          },
          "images": {}
        },
        {
          "id": "/page/27/Text/13",
          "block_type": "Text",
          "html": "<p>In Python 3, the syntax for printing is slightly different: ''</p>",
          "polygon": [
            [
              85.6142578125,
              606.76171875
