    {
      "id": "/page/214/Page/100",
      "block_type": "Page",
      "html": "<content-ref src='/page/214/SectionHeader/0'></content-ref><content-ref src='/page/214/SectionHeader/1'></content-ref><content-ref src='/page/214/Text/2'></content-ref><content-ref src='/page/214/ListGroup/100'></content-ref><content-ref src='/page/214/Text/6'></content-ref><content-ref src='/page/214/SectionHeader/7'></content-ref><content-ref src='/page/214/Text/8'></content-ref><content-ref src='/page/214/Text/9'></content-ref>",
      "polygon": [
        [
          0.0,
          0.0
        ],
        [
