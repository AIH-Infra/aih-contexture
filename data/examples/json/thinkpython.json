        {
          "id": "/page/105/PageHeader/0",
          "block_type": "PageHeader",
          "html": "<p><b>84 Chapter 9. Case study: word play</b></p>",
          "polygon": [
            [
              86.0,
              60.85986328125
            ],
            [
              483.205078125,
