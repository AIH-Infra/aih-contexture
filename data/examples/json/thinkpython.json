            "3": "/page/180/SectionHeader/8"
          },
          "images": {}
        },
        {
          "id": "/page/180/Text/19",
          "block_type": "Text",
          "html": "<p>theses. But the subject is also considered an argument, so all together that's three.</p>",
          "polygon": [
