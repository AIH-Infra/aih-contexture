                "1": "/page/164/SectionHeader/1",
                "3": "/page/166/SectionHeader/7"
              },
              "images": {}
            }
          ],
          "section_hierarchy": {
            "1": "/page/164/SectionHeader/1",
            "3": "/page/166/SectionHeader/7"
          },
          "images": null
        },
        {
          "id": "/page/167/TextInlineMath/3",
          "block_type": "TextInlineMath",
          "html": "<p>box.corner = Point() box.corner.x = 0.0 box.corner.y = 0.0</p>",
          "polygon": [
            [
              85.6142578125,
              190.5556640625
            ],
            [
              191.0,
              190.5556640625
            ],
            [
              191.0,
              227.0
            ],
            [
              85.6142578125,
              227.0
            ]
          ],
          "children": null,
          "section_hierarchy": {
            "1": "/page/164/SectionHeader/1",
            "3": "/page/166/SectionHeader/7"
          },
          "images": {}
        },
        {
          "id": "/page/167/Text/4",
          "block_type": "Text",
          "html": "<p>The expression box.corner.x means, \"Go to the object box refers to and select the attribute named corner; then go to that object and select the attribute named x.\"</p>",
          "polygon": [
            [
              85.6142578125,
              233.0
            ],
            [
              482.90625,
              233.0
            ],
            [
              482.90625,
              256.0
            ],
            [
              85.6142578125,
              256.0
            ]
          ],
          "children": null,
          "section_hierarchy": {
            "1": "/page/164/SectionHeader/1",
            "3": "/page/166/SectionHeader/7"
          },
          "images": {}
        },
        {
          "id": "/page/167/Text/5",
          "block_type": "Text",
          "html": "<p>Figure 15.2 shows the state of this object. An object that is an attribute of another object is <b>embedded</b>.</p>",
          "polygon": [
            [
              86.0,
              265.095703125
            ],
            [
              482.607421875,
              265.095703125
            ],
            [
              482.607421875,
              288.0
            ],
            [
              86.0,
              288.0
            ]
          ],
          "children": null,
          "section_hierarchy": {
            "1": "/page/164/SectionHeader/1",
            "3": "/page/167/SectionHeader/6"
          },
          "images": {}
        },
        {
          "id": "/page/167/SectionHeader/6",
          "block_type": "SectionHeader",
          "html": "<h3><b>15.4 Instances as return values</b></h3>",
          "polygon": [
            [
              85.68896484375,
              316.529296875
            ],
            [
              294.0,
              316.529296875
            ],
            [
              294.0,
              332.0
            ],
            [
              85.68896484375,
              332.0
            ]
          ],
          "children": null,
          "section_hierarchy": {
            "1": "/page/164/SectionHeader/1",
            "3": "/page/167/SectionHeader/6"
          },
          "images": {}
        },
        {
          "id": "/page/167/Text/7",
          "block_type": "Text",
          "html": "<p>Functions can return instances. For example, find_center takes a Rectangle as an argument and returns a Point that contains the coordinates of the center of the Rectangle:</p>",
          "polygon": [
            [
              85.6142578125,
              344.0
            ],
            [
              482.90625,
              344.0
            ],
            [
              482.90625,
              366.609375
            ],
            [
              85.6142578125,
              366.609375
            ]
          ],
          "children": null,
          "section_hierarchy": {
            "1": "/page/164/SectionHeader/1",
            "3": "/page/167/SectionHeader/6"
          },
          "images": {}
        },
        {
          "id": "/page/167/Code/8",
          "block_type": "Code",
          "html": "<pre>def find_center(rect):\n    p = Point()\n    p.x = rect.corner.x + rect.width/2.0\n    p.y = rect.corner.y + rect.height/2.0\n    return p</pre>",
          "polygon": [
            [
              86.0,
              371.25
            ],
            [
              301.0693359375,
              371.25
            ],
            [
              301.0693359375,
              433.125
            ],
            [
              86.0,
              433.125
            ]
          ],
          "children": null,
          "section_hierarchy": {
            "1": "/page/164/SectionHeader/1",
            "3": "/page/167/SectionHeader/6"
          },
          "images": {}
        },
        {
          "id": "/page/167/Text/9",
          "block_type": "Text",
          "html": "<p>Here is an example that passes box as an argument and assigns the resulting Point to center:</p>",
          "polygon": [
            [
              85.3154296875,
              438.0
            ],
            [
              482.90625,
              438.0
            ],
            [
              482.90625,
              460.0
            ],
            [
              85.3154296875,
              460.0
            ]
          ],
          "children": null,
          "section_hierarchy": {
            "1": "/page/164/SectionHeader/1",
            "3": "/page/167/SectionHeader/6"
          },
          "images": {}
        },
        {
          "id": "/page/167/Code/10",
          "block_type": "Code",
          "html": "<pre>&gt;&gt;&gt; center = find_center(box)\n&gt;&gt;&gt; print_point(center)\n(50.0, 100.0)</pre>",
          "polygon": [
            [
              84.4189453125,
              466.0
            ],
            [
              238.0,
              466.0
            ],
            [
              238.0,
              500.0
            ],
            [
              84.4189453125,
              500.0
            ]
          ],
          "children": null,
          "section_hierarchy": {
            "1": "/page/164/SectionHeader/1",
            "3": "/page/167/SectionHeader/11"
          },
          "images": {}
        },
        {
          "id": "/page/167/SectionHeader/11",
          "block_type": "SectionHeader",
          "html": "<h3><b>15.5 Objects are mutable</b></h3>",
          "polygon": [
            [
              85.39013671875,
              529.8046875
            ],
            [
              257.888671875,
              529.8046875
            ],
            [
              257.888671875,
              545.2734375
            ],
            [
              85.39013671875,
              545.2734375
            ]
          ],
          "children": null,
          "section_hierarchy": {
            "1": "/page/164/SectionHeader/1",
            "3": "/page/167/SectionHeader/11"
          },
          "images": {}
        },
        {
          "id": "/page/167/Text/12",
          "block_type": "Text",
          "html": "<p>You can change the state of an object by making an assignment to one of its attributes. For example, to change the size of a rectangle without changing its position, you can modify the values of width and height:</p>",
          "polygon": [
            [
              86.0,
              555.71484375
            ],
            [
              482.30859375,
              555.71484375
            ],
            [
              482.30859375,
              591.0
            ],
            [
              86.0,
              591.0
            ]
          ],
          "children": null,
          "section_hierarchy": {
            "1": "/page/164/SectionHeader/1",
            "3": "/page/167/SectionHeader/11"
          },
          "images": {}
        },
        {
          "id": "/page/167/Code/13",
          "block_type": "Code",
          "html": "<pre>box.width = box.width + 50\nbox.height = box.width + 100</pre>",
          "polygon": [
            [
              84.7177734375,
              597.0
            ],
            [
              234.1318359375,
              595.546875
            ],
            [
              234.1318359375,
              619.0
            ],
            [
              84.7177734375,
              619.0
            ]
          ],
          "children": null,
          "section_hierarchy": {
            "1": "/page/164/SectionHeader/1",
            "3": "/page/167/SectionHeader/11"
          },
          "images": {}
        },
        {
          "id": "/page/167/Text/14",
          "block_type": "Text",
          "html": "<p>You can also write functions that modify objects. For example, grow_rectangle takes a Rectangle object and two numbers, dwidth and dheight, and adds the numbers to the width and height of the rectangle:</p>",
          "polygon": [
            [
              85.763671875,
              623.390625
            ],
            [
              482.90625,
              623.390625
            ],
            [
              482.90625,
              660.0
            ],
            [
              85.763671875,
              660.0
            ]
          ],
          "children": null,
          "section_hierarchy": {
            "1": "/page/164/SectionHeader/1",
            "3": "/page/167/SectionHeader/11"
          },
          "images": {}
        },
        {
          "id": "/page/167/Code/15",
          "block_type": "Code",
          "html": "<pre>def grow_rectangle(rect, dwidth, dheight):\n    rect.width += dwidth\n    rect.height += dheight</pre>",
          "polygon": [
            [
              85.763671875,
              664.76953125
            ],
            [
              306.0,
              664.76953125
            ],
            [
              306.0,
              701.89453125
            ],
            [
              85.763671875,
              701.89453125
            ]
          ],
          "children": null,
          "section_hierarchy": {
            "1": "/page/164/SectionHeader/1",
            "3": "/page/167/SectionHeader/11"
          },
          "images": {}
        }
      ],
      "section_hierarchy": {
        "1": "/page/164/SectionHeader/1",
        "3": "/page/167/SectionHeader/11"
      },
      "images": null
    },
    {
      "id": "/page/168/Page/229",
      "block_type": "Page",
      "html": "<content-ref src='/page/168/PageHeader/0'></content-ref><content-ref src='/page/168/PageHeader/12'></content-ref><content-ref src='/page/168/Text/1'></content-ref><content-ref src='/page/168/Code/2'></content-ref><content-ref src='/page/168/Text/3'></content-ref><content-ref src='/page/168/SectionHeader/4'></content-ref><content-ref src='/page/168/Text/5'></content-ref><content-ref src='/page/168/Text/6'></content-ref><content-ref src='/page/168/Code/7'></content-ref><content-ref src='/page/168/Text/8'></content-ref><content-ref src='/page/168/Code/9'></content-ref><content-ref src='/page/168/Text/10'></content-ref><content-ref src='/page/168/Text/11'></content-ref>",
      "polygon": [
        [
          0.0,
          0.0
        ],
        [
          612.0,
          0.0
        ],
        [
          612.0,
          792.0
        ],
        [
