        {
          "id": "/page/48/PageHeader/14",
          "block_type": "PageHeader",
          "html": "<p></p>",
          "polygon": [
            [
              515.478515625,
              61.3916015625
            ],
            [
              526.236328125,
              61.3916015625
            ],
            [
              526.236328125,
