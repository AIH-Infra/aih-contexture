          "children": null,
          "section_hierarchy": {
            "1": "/page/188/SectionHeader/1",
            "3": "/page/188/SectionHeader/4"
          },
          "images": {}
        },
        {
          "id": "/page/189/Text/6",
          "block_type": "Text",
          "html": "<p>To create a Card, you call Card with the suit and rank of the card you want.</p>",
