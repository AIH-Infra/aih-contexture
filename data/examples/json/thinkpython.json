          "section_hierarchy": {
            "1": "/page/108/SectionHeader/1",
            "3": "/page/113/SectionHeader/6"
          },
          "images": {}
        },
        {
          "id": "/page/113/Text/13",
          "block_type": "Text",
          "html": "<p>To remove more than one element, you can use del with a slice index: &gt;&gt;&gt; t = ['a', 'b', 'c', 'd', 'e', 'f']</p>",
          "polygon": [
            [
              86.0,
              574.6640625
            ],
            [
              394.751953125,
              574.6640625
