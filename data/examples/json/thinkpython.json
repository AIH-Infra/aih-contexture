          "children": null,
          "section_hierarchy": {
            "1": "/page/62/SectionHeader/1",
            "3": "/page/64/SectionHeader/5"
          },
          "images": {}
        },
        {
          "id": "/page/64/Text/10",
          "block_type": "Text",
          "html": "<p>Each condition is checked in order. If the first is false, the next is checked, and so on. If one of them is true, the corresponding branch executes, and the statement ends. Even if more than one condition is true, only the first true branch executes.</p>",
          "polygon": [
            [
              128.49609375,
              533.28515625
