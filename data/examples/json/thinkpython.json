        {
          "id": "/page/55/SectionHeader/4",
          "block_type": "SectionHeader",
          "html": "<h3><b>4.4 Encapsulation</b></h3>",
          "polygon": [
            [
              85.763671875,
              225.0
            ],
            [
              212.0,
              225.0
