            ],
            [
              85.3154296875,
              439.0
            ]
          ],
          "children": null,
          "section_hierarchy": {
            "1": "/page/108/SectionHeader/1",
            "3": "/page/113/SectionHeader/6"
          },
          "images": {}
        },
        {
          "id": "/page/113/Code/11",
          "block_type": "Code",
          "html": "<pre>&gt;&gt;&gt; t = [a, b, c]\n&gt;&gt;&gt; del t[1]\n&gt;&gt;&gt; print t\n['a', 'c']\nIf you know the element you want to remove (but not the index), you can use remove:\n&gt;&gt;&gt; t = ['a', 'b', 'c']\n&gt;&gt;&gt; t.remove('b')\n&gt;&gt;&gt; print t\n['a', 'c']</pre>",
          "polygon": [
            [
              85.166015625,
              438.15234375
            ],
            [
              463.0,
              438.15234375
            ],
            [
              463.0,
              560.35546875
            ],
            [
