          },
          "images": {}
        },
        {
          "id": "/page/130/PageHeader/17",
          "block_type": "PageHeader",
          "html": "<p></p>",
          "polygon": [
            [
              510.697265625,
              60.2314453125
            ],
            [
              525.638671875,
              60.2314453125
            ],
            [
              525.638671875,
