          },
          "images": {}
        },
        {
          "id": "/page/120/Text/4",
          "block_type": "Text",
          "html": "<p><i>Or you could read the documentation of the</i> bisect <i>module and use that! Solution:</i> http: // thinkpython. com/ code/ inlist. py .</p>",
          "polygon": [
