          "images": {}
        },
        {
          "id": "/page/180/Text/12",
          "block_type": "Text",
          "html": "<p>This version assumes that time_to_int is written as a method, as in Exercise 17.1. Also, note that it is a pure function, not a modifier.</p>",
          "polygon": [
