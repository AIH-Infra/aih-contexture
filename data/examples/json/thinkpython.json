          },
          "images": {}
        },
        {
          "id": "/page/209/Code/5",
          "block_type": "Code",
          "html": "<pre>def drop(self, event):\n    self.config(fill=self.fill)</pre>",
          "polygon": [
            [
              107.0,
              212.6953125
            ],
            [
              269.0,
              212.6953125
            ],
            [
              269.0,
              237.0
