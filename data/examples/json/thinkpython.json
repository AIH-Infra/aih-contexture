    {
      "id": "/page/232/Page/99",
      "block_type": "Page",
      "html": "<content-ref src='/page/232/SectionHeader/0'></content-ref><content-ref src='/page/232/SectionHeader/1'></content-ref><content-ref src='/page/232/Text/2'></content-ref><content-ref src='/page/232/Text/3'></content-ref><content-ref src='/page/232/Text/4'></content-ref><content-ref src='/page/232/Text/5'></content-ref><content-ref src='/page/232/Text/6'></content-ref><content-ref src='/page/232/Text/7'></content-ref><content-ref src='/page/232/Text/8'></content-ref><content-ref src='/page/232/Text/9'></content-ref><content-ref src='/page/232/Text/10'></content-ref><content-ref src='/page/232/SectionHeader/11'></content-ref><content-ref src='/page/232/Text/12'></content-ref>",
      "polygon": [
        [
