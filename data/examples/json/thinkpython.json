          ],
          "children": null,
          "section_hierarchy": {
            "1": "/page/102/SectionHeader/1",
            "3": "/page/103/SectionHeader/3"
          },
          "images": {}
        },
        {
          "id": "/page/103/Text/6",
          "block_type": "Text",
          "html": "<p><i>In fact, it is difficult to construct a solitary thought without using that most common symbol. It is</i> <i>slow going at first, but with caution and hours of training you can gradually gain facility.</i></p>",
          "polygon": [
            [
              85.3154296875,
              356.5546875
