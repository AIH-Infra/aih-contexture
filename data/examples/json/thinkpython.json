            "3": "/page/236/SectionHeader/9",
            "4": "/page/237/SectionHeader/5"
          },
          "images": {}
        },
        {
          "id": "/page/237/Text/6",
          "block_type": "Text",
          "html": "<p>Figure C.6 shows the result. Since we invoke object_diagram inside a function, we get a stack diagram with a frame for the module-level variables and for the invocation of instantiate.</p>",
          "polygon": [
            [
              86.0,
              507.76171875
            ],
            [
              483.205078125,
              507.76171875
            ],
            [
              483.205078125,
              543.0
