              },
              "images": {}
            },
            {
              "id": "/page/177/ListItem/3",
              "block_type": "ListItem",
              "html": "<li><b>functional programming style:</b> A style of program design in which the majority of functions are pure.</li>",
              "polygon": [
                [
                  86.0,
