              189.0
            ],
            [
              85.6142578125,
              189.0
            ]
          ],
          "children": null,
          "section_hierarchy": {
            "1": "/page/178/SectionHeader/1",
            "3": "/page/179/SectionHeader/4"
          },
          "images": {}
        },
        {
          "id": "/page/179/SectionHeader/4",
          "block_type": "SectionHeader",
          "html": "<h3><b>17.2 Printing objects</b></h3>",
          "polygon": [
            [
              85.68896484375,
              216.755859375
            ],
            [
              230.0,
              215.208984375
            ],
            [
              230.0,
              231.064453125
            ],
            [
              85.68896484375,
              232.611328125
            ]
          ],
          "children": null,
          "section_hierarchy": {
            "1": "/page/178/SectionHeader/1",
            "3": "/page/179/SectionHeader/4"
          },
          "images": {}
        },
        {
          "id": "/page/179/Text/5",
          "block_type": "Text",
          "html": "<p>In Chapter 16, we defined a class named Time and in Exercise 16.1, you wrote a function named print_time:</p>",
          "polygon": [
            [
              85.9130859375,
              242.279296875
            ],
            [
              482.90625,
