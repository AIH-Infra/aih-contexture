        {
          "id": "/page/76/SectionHeader/9",
          "block_type": "SectionHeader",
          "html": "<h3><b>6.5 More recursion</b></h3>",
          "polygon": [
            [
              128.0478515625,
              386.912109375
            ],
            [
              262.0,
              386.912109375
            ],
            [
              262.0,
