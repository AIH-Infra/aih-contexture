        {
          "id": "/page/158/SectionHeader/17",
          "block_type": "SectionHeader",
          "html": "<h3><b>14.7 Pickling</b></h3>",
          "polygon": [
            [
              127.599609375,
              583.55859375
            ],
            [
              224.419921875,
              583.55859375
            ],
