          "children": null,
          "section_hierarchy": {
            "1": "/page/200/SectionHeader/1",
            "3": "/page/200/SectionHeader/2"
          },
          "images": {}
        },
        {
          "id": "/page/201/Text/4",
          "block_type": "Text",
          "html": "<p><b>Canvas:</b> A region that can display lines, rectangles, circles and other shapes.</p>",
          "polygon": [
            [
              85.9130859375,
              178.7607421875
