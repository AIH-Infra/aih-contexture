          "children": [
            {
              "id": "/page/177/ListItem/1",
              "block_type": "ListItem",
              "html": "<li><b>pure function:</b> A function that does not modify any of the objects it receives as arguments. Most pure functions are fruitful.</li>",
              "polygon": [
                [
                  85.46484375,
                  88.9453125
                ],
                [
                  482.90625,
                  88.9453125
                ],
                [
                  482.90625,
                  111.0
                ],
                [
                  85.46484375,
