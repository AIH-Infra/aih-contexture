          "children": null,
          "section_hierarchy": {
            "1": "/page/122/SectionHeader/1",
            "3": "/page/131/SectionHeader/7"
          },
          "images": {}
        },
        {
          "id": "/page/131/Text/8",
          "block_type": "Text",
          "html": "<p><b>dictionary:</b> A mapping from a set of keys to their corresponding values.</p>",
          "polygon": [
