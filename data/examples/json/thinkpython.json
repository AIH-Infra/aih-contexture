          "children": null,
          "section_hierarchy": {
            "1": "/page/108/SectionHeader/1",
            "3": "/page/108/SectionHeader/12"
          },
          "images": {}
        },
        {
          "id": "/page/109/Text/8",
          "block_type": "Text",
          "html": "<p>List indices work the same way as string indices:</p>",
