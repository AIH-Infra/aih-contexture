              },
              "images": {}
            },
            {
              "id": "/page/59/ListItem/11",
              "block_type": "ListItem",
              "html": "<li><b>loop:</b> A part of a program that can execute repeatedly.</li>",
              "polygon": [
                [
                  86.0,
                  529.03125
                ],
                [
                  326.619140625,
                  529.03125
                ],
                [
