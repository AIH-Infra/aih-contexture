    {
      "id": "/page/160/Page/212",
      "block_type": "Page",
      "html": "<content-ref src='/page/160/PageHeader/0'></content-ref><content-ref src='/page/160/PageHeader/14'></content-ref><content-ref src='/page/160/TextInlineMath/1'></content-ref><content-ref src='/page/160/Text/2'></content-ref><content-ref src='/page/160/Text/3'></content-ref><content-ref src='/page/160/Code/4'></content-ref><content-ref src='/page/160/Text/5'></content-ref><content-ref src='/page/160/ListGroup/212'></content-ref><content-ref src='/page/160/Text/9'></content-ref><content-ref src='/page/160/SectionHeader/10'></content-ref><content-ref src='/page/160/Text/11'></content-ref><content-ref src='/page/160/Code/12'></content-ref><content-ref src='/page/160/Text/13'></content-ref>",
      "polygon": [
