            "3": "/page/204/SectionHeader/12"
          },
          "images": {}
        },
        {
          "id": "/page/205/Code/9",
          "block_type": "Code",
          "html": "<pre>self.row([0,1], pady=30)\nself.bu(text='Run file', command=self.run_file)\nself.en_file = self.en(text='snowflake.py', width=5)\nself.endrow()</pre>",
