      "children": [
        {
          "id": "/page/53/PageHeader/0",
          "block_type": "PageHeader",
          "html": "<p><b>32 Chapter 4. Case study: interface design</b></p>",
          "polygon": [
            [
              86.0,
              60.71484375
            ],
            [
              483.50390625,
              60.71484375
            ],
            [
              483.50390625,
