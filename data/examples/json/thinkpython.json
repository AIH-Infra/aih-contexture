          "images": {}
        },
        {
          "id": "/page/187/Text/8",
          "block_type": "Text",
          "html": "<p>color <i>is an RGB tuple; that is, the elements are Red-Green-Blue levels between 0.0 and 1.0 (see</i> http: // en. wikipedia. org/ wiki/ RGB_ color_ model ).</p>",
          "polygon": [
