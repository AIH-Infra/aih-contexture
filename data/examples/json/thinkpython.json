            ]
          ],
          "children": null,
          "section_hierarchy": {
            "1": "/page/214/SectionHeader/1",
            "3": "/page/221/SectionHeader/1"
          },
          "images": {}
        },
        {
          "id": "/page/221/ListGroup/119",
          "block_type": "ListGroup",
          "html": "<p><ul><content-ref src='/page/221/ListItem/3'></content-ref><content-ref src='/page/221/ListItem/4'></content-ref><content-ref src='/page/221/ListItem/5'></content-ref></ul></p>",
          "polygon": [
            [
              100.0,
              144.826171875
            ],
            [
              484.400390625,
              144.826171875
            ],
            [
              484.400390625,
              221.009765625
            ],
            [
              100.0,
              221.009765625
            ]
          ],
          "children": [
            {
              "id": "/page/221/ListItem/3",
              "block_type": "ListItem",
              "html": "<li> Frustration and rage.</li>",
              "polygon": [
                [
                  100.0,
