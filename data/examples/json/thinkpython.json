            [
              260.578125,
              547.0
            ],
            [
              129.392578125,
              547.0
            ]
          ],
          "children": null,
          "section_hierarchy": {
            "1": "/page/52/SectionHeader/1",
            "3": "/page/52/SectionHeader/3"
          },
          "images": {}
        },
        {
          "id": "/page/52/Text/10",
          "block_type": "Text",
          "html": "<p>The details of the installation process and setting Python's search path depend on your system, so rather than include those details here, I will try to maintain current information for several systems at http://thinkpython.com/swampy</p>",
          "polygon": [
