              128.9443359375,
              306.474609375
            ]
          ],
          "children": null,
          "section_hierarchy": {
            "1": "/page/62/SectionHeader/1",
            "3": "/page/67/SectionHeader/10"
          },
          "images": {}
        },
        {
          "id": "/page/68/Text/6",
          "block_type": "Text",
          "html": "<p>But if the user types something other than a string of digits, you get an error:</p>",
          "polygon": [
            [
              128.794921875,
              307.44140625
            ],
            [
              467.3671875,
              307.44140625
            ],
            [
