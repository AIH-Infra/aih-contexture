          },
          "images": {}
        },
        {
          "id": "/page/123/Code/10",
          "block_type": "Code",
          "html": "<pre>&gt;&gt;&gt; vals = eng2sp.values()\n&gt;&gt;&gt; 'uno' in vals\nTrue</pre>",
          "polygon": [
            [
              85.166015625,
              341.0
            ],
