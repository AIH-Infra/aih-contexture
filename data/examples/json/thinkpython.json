            "1": "/page/188/SectionHeader/1",
            "3": "/page/198/SectionHeader/7",
            "4": "/page/199/SectionHeader/3"
          },
          "images": null
        },
        {
          "id": "/page/199/Text/13",
          "block_type": "Text",
          "html": "<p><i>Adjust the rules and your</i> steer <i>method for good quality play; for example, it should be</i> <i>possible for the slow Turtle to tag the faster Turtles eventually.</i></p>",
          "polygon": [
