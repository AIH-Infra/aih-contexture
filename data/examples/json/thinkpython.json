            "3": "/page/67/SectionHeader/10"
          },
          "images": {}
        },
        {
          "id": "/page/68/Code/7",
          "block_type": "Code",
          "html": "<pre>&gt;&gt;&gt; speed = raw_input(prompt)\nWhat...is the airspeed velocity of an unladen swallow?\nWhat do you mean, an African or a European swallow?\n&gt;&gt;&gt; int(speed)\nValueError: invalid literal for int() with base 10</pre>",
          "polygon": [
