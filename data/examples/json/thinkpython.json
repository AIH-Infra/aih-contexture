          "images": {}
        },
        {
          "id": "/page/68/Code/14",
          "block_type": "Code",
          "html": "<pre>&gt;&gt;&gt; x = 5\n&gt;&gt;&gt; y = 6\n  File \"&lt;stdin&gt;\", line 1\n    y = 6\n    ^</pre>",
          "polygon": [
            [
              128.794921875,
              577.0
            ],
            [
              259.083984375,
              577.0
            ],
            [
              259.083984375,
              636.0
