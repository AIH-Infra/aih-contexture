            "3": "/page/237/SectionHeader/9"
          },
          "images": {}
        },
        {
          "id": "/page/238/Code/6",
          "block_type": "Code",
          "html": "<pre>lumpy = Lumpy()\nlumpy.make_reference()\nbox = Rectangle()\nbox.width = 100.0\nbox.height = 200.0\nbox.corner = Point()\nbox.corner.x = 0.0\nbox.corner.y = 0.0</pre>",
          "polygon": [
