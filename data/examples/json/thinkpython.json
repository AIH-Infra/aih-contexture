              127.7490234375,
              276.0
            ]
          ],
          "children": null,
          "section_hierarchy": {
            "1": "/page/172/SectionHeader/1",
            "3": "/page/174/SectionHeader/4"
          },
          "images": {}
        },
        {
          "id": "/page/174/Text/5",
          "block_type": "Text",
          "html": "<p>Sometimes it is useful for a function to modify the objects it gets as parameters. In that case, the changes are visible to the caller. Functions that work this way are called <b>modifiers</b>.</p>",
          "polygon": [
            [
              129.2431640625,
              286.751953125
            ],
            [
              526.0,
              286.751953125
            ],
            [
              526.0,
              309.0
            ],
            [
              129.2431640625,
              309.0
            ]
          ],
          "children": null,
          "section_hierarchy": {
            "1": "/page/172/SectionHeader/1",
            "3": "/page/174/SectionHeader/4"
          },
          "images": {}
        },
        {
          "id": "/page/174/Text/6",
          "block_type": "Text",
          "html": "<p>increment, which adds a given number of seconds to a Time object, can be written naturally as a modifier. Here is a rough draft:</p>",
          "polygon": [
            [
              129.392578125,
              317.0
            ],
            [
              526.0,
              317.0
            ],
            [
              526.0,
              340.892578125
            ],
            [
              129.392578125,
              340.892578125
            ]
          ],
          "children": null,
          "section_hierarchy": {
            "1": "/page/172/SectionHeader/1",
            "3": "/page/174/SectionHeader/4"
          },
          "images": {}
        },
        {
          "id": "/page/174/Code/7",
          "block_type": "Code",
          "html": "<pre>def increment(time, seconds):\n    time.second += seconds</pre>",
          "polygon": [
            [
              130.0,
              344.0
            ],
            [
              281.0,
              344.0
            ],
            [
              281.0,
              366.0
            ],
            [
              130.0,
              366.0
            ]
          ],
          "children": null,
          "section_hierarchy": {
            "1": "/page/172/SectionHeader/1",
            "3": "/page/174/SectionHeader/4"
          },
          "images": {}
        },
        {
          "id": "/page/174/Code/8",
          "block_type": "Code",
          "html": "<pre>if time.second &gt;= 60:\n    time.second -= 60\n    time.minute += 1</pre>",
          "polygon": [
            [
              151.0,
              369.509765625
            ],
            [
              265.359375,
              369.509765625
            ],
            [
              265.359375,
              423.84375
            ],
            [
              151.0,
              423.84375
            ]
          ],
          "children": null,
          "section_hierarchy": {
            "1": "/page/172/SectionHeader/1",
            "3": "/page/174/SectionHeader/4"
          },
          "images": {}
        },
        {
          "id": "/page/174/Code/9",
          "block_type": "Code",
          "html": "<pre>if time.minute &gt;= 60:\n    time.minute -= 60\n    time.hour += 1</pre>",
          "polygon": [
            [
              150.609375,
              429.0
            ],
            [
              260.578125,
              429.0
            ],
            [
              260.578125,
              464.8359375
            ],
            [
              150.609375,
              464.8359375
            ]
          ],
          "children": null,
          "section_hierarchy": {
            "1": "/page/172/SectionHeader/1",
            "3": "/page/174/SectionHeader/4"
          },
          "images": {}
        },
        {
          "id": "/page/174/Text/10",
          "block_type": "Text",
          "html": "<p>The first line performs the basic operation; the remainder deals with the special cases we saw before.</p>",
          "polygon": [
            [
              129.69140625,
              468.0
            ],
            [
              526.53515625,
              468.0
            ],
            [
              526.53515625,
              491.51953125
            ],
            [
              129.69140625,
              491.51953125
            ]
          ],
          "children": null,
          "section_hierarchy": {
            "1": "/page/172/SectionHeader/1",
            "3": "/page/174/SectionHeader/4"
          },
          "images": {}
        },
        {
          "id": "/page/174/Text/11",
          "block_type": "Text",
          "html": "<p>Is this function correct? What happens if the parameter seconds is much greater than sixty?</p>",
          "polygon": [
            [
              128.6455078125,
              498.48046875
            ],
            [
              526.0,
              498.48046875
            ],
            [
              526.0,
              509.0
            ],
            [
              128.6455078125,
              509.0
            ]
          ],
          "children": null,
          "section_hierarchy": {
            "1": "/page/172/SectionHeader/1",
            "3": "/page/174/SectionHeader/4"
          },
          "images": {}
        },
        {
          "id": "/page/174/Text/12",
          "block_type": "Text",
          "html": "<p>In that case, it is not enough to carry once; we have to keep doing it until time.second is less than sixty. One solution is to replace the if statements with while statements. That would make the function correct, but not very efficient.</p>",
          "polygon": [
            [
              129.09375,
              517.0
            ],
            [
              526.0,
              517.0
            ],
            [
              526.0,
              553.39453125
            ],
            [
              129.09375,
              553.39453125
            ]
          ],
          "children": null,
          "section_hierarchy": {
            "1": "/page/172/SectionHeader/1",
            "3": "/page/174/SectionHeader/4"
          },
          "images": {}
        },
        {
          "id": "/page/174/Text/13",
          "block_type": "Text",
          "html": "<p><b>Exercise 16.3.</b> <i>Write a correct version of</i> increment <i>that doesn't contain any loops.</i></p>",
          "polygon": [
            [
              129.5419921875,
              553.78125
            ],
            [
              470.0,
              553.78125
            ],
            [
              470.0,
              564.0
            ],
            [
              129.5419921875,
              564.0
            ]
          ],
          "children": null,
          "section_hierarchy": {
            "1": "/page/172/SectionHeader/1",
            "3": "/page/174/SectionHeader/4"
          },
          "images": {}
        },
        {
          "id": "/page/174/Text/14",
          "block_type": "Text",
          "html": "<p>Anything that can be done with modifiers can also be done with pure functions. In fact, some programming languages only allow pure functions. There is some evidence that programs that use pure functions are faster to develop and less error-prone than programs that use modifiers. But modifiers are convenient at times, and functional programs tend to be less efficient.</p>",
          "polygon": [
            [
              128.197265625,
              570.796875
            ],
            [
              526.0,
              570.796875
            ],
            [
              526.0,
              631.0
            ],
            [
              128.197265625,
              631.0
            ]
          ],
          "children": null,
          "section_hierarchy": {
            "1": "/page/172/SectionHeader/1",
            "3": "/page/174/SectionHeader/4"
          },
          "images": {}
        },
        {
          "id": "/page/174/Text/15",
          "block_type": "Text",
          "html": "<p>In general, I recommend that you write pure functions whenever it is reasonable and resort to modifiers only if there is a compelling advantage. This approach might be called a <b>functional programming style</b>.</p>",
          "polygon": [
            [
              128.9443359375,
              638.859375
            ],
            [
              526.53515625,
              638.859375
            ],
            [
              526.53515625,
              674.0
            ],
            [
              128.9443359375,
              674.0
            ]
          ],
          "children": null,
          "section_hierarchy": {
            "1": "/page/172/SectionHeader/1",
            "3": "/page/174/SectionHeader/4"
          },
          "images": {}
        },
        {
          "id": "/page/174/Text/16",
          "block_type": "Text",
          "html": "<p><b>Exercise 16.4.</b> <i>Write a \"pure\" version of</i> increment <i>that creates and returns a new Time object</i> <i>rather than modifying the parameter.</i></p>",
          "polygon": [
            [
              128.3466796875,
              675.59765625
            ],
            [
              526.0,
              675.59765625
            ],
            [
              526.0,
              698.0
            ],
            [
              128.3466796875,
              698.0
            ]
          ],
          "children": null,
          "section_hierarchy": {
            "1": "/page/172/SectionHeader/1",
            "3": "/page/174/SectionHeader/4"
          },
          "images": {}
        }
      ],
      "section_hierarchy": {
        "1": "/page/172/SectionHeader/1",
        "3": "/page/174/SectionHeader/4"
      },
      "images": null
    },
    {
      "id": "/page/175/Page/204",
