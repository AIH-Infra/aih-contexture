          },
          "images": {}
        },
        {
          "id": "/page/27/Text/12",
          "block_type": "Text",
          "html": "<p>The quotation marks in the program mark the beginning and end of the text to be displayed; they don't appear in the result.</p>",
          "polygon": [
            [
              85.763671875,
              573.890625
            ],
            [
