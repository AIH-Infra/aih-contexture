        {
          "id": "/page/3/Text/1",
          "block_type": "Text",
          "html": "<p>Green Tea Press 9 Washburn Ave Needham MA 02492</p>",
          "polygon": [
            [
              85.53955078125,
              117.5625
            ],
            [
              169.13671875,
