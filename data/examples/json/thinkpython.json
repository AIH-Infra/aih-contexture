              },
              "images": {}
            },
            {
              "id": "/page/186/ListItem/9",
              "block_type": "ListItem",
              "html": "<li><b>type-based dispatch:</b> A programming pattern that checks the type of an operand and invokes different functions for different types.</li>",
              "polygon": [
