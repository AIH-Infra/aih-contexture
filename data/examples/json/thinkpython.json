      ],
      "children": [
        {
          "id": "/page/210/PageHeader/0",
          "block_type": "PageHeader",
          "html": "<p><b>19.10. Glossary 189</b></p>",
          "polygon": [
            [
              128.6455078125,
              61.0
            ],
            [
              526.0,
              61.0
            ],
            [
              526.0,
              71.2529296875
            ],
            [
