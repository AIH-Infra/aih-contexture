        },
        {
          "id": "/page/146/Text/3",
          "block_type": "Text",
          "html": "<p>Here is a program that reads a file and builds a histogram of the words in the file:</p>",
          "polygon": [
            [
              129.2431640625,
              156.7177734375
            ],
            [
              487.6875,
