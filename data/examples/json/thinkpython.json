          },
          "images": {}
        },
        {
          "id": "/page/179/Text/9",
          "block_type": "Text",
          "html": "<p>To make print_time a method, all we have to do is move the function definition inside the class definition. Notice the change in indentation.</p>",
          "polygon": [
            [
              86.0,
              424.6171875
            ],
            [
              482.90625,
              424.6171875
            ],
            [
