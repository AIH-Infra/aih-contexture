            ]
          ],
          "children": null,
          "section_hierarchy": {
            "1": "/page/178/SectionHeader/1",
            "3": "/page/179/SectionHeader/4"
          },
          "images": {}
        },
        {
          "id": "/page/179/Code/6",
          "block_type": "Code",
          "html": "<pre>class Time(object):\n    \"\"\"Represents the time of day.\"\"\"</pre>",
          "polygon": [
            [
              85.9130859375,
              269.15625
            ],
            [
              426.12890625,
              269.15625
            ],
            [
              426.12890625,
              305.89453125
            ],
            [
              85.9130859375,
              305.89453125
            ]
          ],
          "children": null,
          "section_hierarchy": {
            "1": "/page/178/SectionHeader/1",
