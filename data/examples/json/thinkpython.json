          },
          "images": {}
        },
        {
          "id": "/page/180/Text/15",
          "block_type": "Text",
          "html": "<p>The subject, start, gets assigned to the first parameter, self. The argument, 1337, gets assigned to the second parameter, seconds.</p>",
          "polygon": [
