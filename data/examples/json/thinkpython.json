            "3": "/page/209/SectionHeader/9"
          },
          "images": {}
        },
        {
          "id": "/page/209/Code/12",
          "block_type": "Code",
          "html": "<pre>def the_callback():\n    print 'Called.'</pre>",
          "polygon": [
            [
              86.0,
              487.0
