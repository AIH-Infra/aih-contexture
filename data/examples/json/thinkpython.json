      "children": [
        {
          "id": "/page/42/PageHeader/0",
          "block_type": "PageHeader",
          "html": "<p><b>3.4. Composition 21</b></p>",
          "polygon": [
            [
              128.794921875,
              60.71484375
            ],
            [
              526.0,
              60.71484375
            ],
            [
              526.0,
              71.0
