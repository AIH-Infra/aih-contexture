        {
          "id": "/page/166/Code/1",
          "block_type": "Code",
          "html": "<pre>&gt;&gt;&gt; print (%g, %g) % (blank.x, blank.y)\n(3.0, 4.0)\n&gt;&gt;&gt; distance = math.sqrt(blank.x**2 + blank.y**2)\n&gt;&gt;&gt; print distance\n5.0</pre>",
