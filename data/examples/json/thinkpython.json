            "3": "/page/158/SectionHeader/17"
          },
          "images": {}
        },
        {
          "id": "/page/158/Text/18",
          "block_type": "Text",
          "html": "<p>A limitation of anydbm is that the keys and values have to be strings. If you try to use any other type, you get an error.</p>",
          "polygon": [
            [
              128.49609375,
              611.7890625
            ],
            [
              526.0,
              611.7890625
            ],
            [
              526.0,
              634.9921875
            ],
            [
              128.49609375,
              634.9921875
            ]
          ],
          "children": null,
          "section_hierarchy": {
            "1": "/page/154/SectionHeader/1",
            "3": "/page/158/SectionHeader/17"
          },
          "images": {}
        },
        {
          "id": "/page/158/Text/19",
          "block_type": "Text",
          "html": "<p>The pickle module can help. It translates almost any type of object into a string suitable for storage in a database, and then translates strings back into objects.</p>",
          "polygon": [
            [
              127.7490234375,
              645.0
            ],
            [
              526.53515625,
              645.0
            ],
            [
              526.53515625,
              668.0
            ],
            [
              127.7490234375,
              668.0
            ]
          ],
          "children": null,
          "section_hierarchy": {
            "1": "/page/154/SectionHeader/1",
            "3": "/page/158/SectionHeader/17"
          },
          "images": {}
        },
        {
          "id": "/page/158/Text/20",
          "block_type": "Text",
          "html": "<p>pickle.dumps takes an object as a parameter and returns a string representation (dumps is short for \"dump string\"):</p>",
          "polygon": [
            [
              127.8984375,
              677.91796875
            ],
            [
              526.0,
              677.91796875
