          "images": {}
        },
        {
          "id": "/page/5/Text/1",
          "block_type": "Text",
          "html": "<p>Over the last nine years I continued to develop the book, correcting errors, improving some of the examples and adding material, especially exercises.</p>",
          "polygon": [
            [
              86.0,
              87.3984375
            ],
            [
              482.607421875,
              87.3984375
            ],
            [
              482.607421875,
              111.0
            ],
            [
              86.0,
