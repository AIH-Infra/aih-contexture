          },
          "images": {}
        },
        {
          "id": "/page/63/Text/11",
          "block_type": "Text",
          "html": "<p>This flexibility can be useful, but there are some subtleties to it that might be confusing. You might want to avoid it (unless you know what you are doing).</p>",
          "polygon": [
            [
              86.0,
              421.91015625
