          "children": null,
          "section_hierarchy": {
            "1": "/page/200/SectionHeader/1",
            "3": "/page/200/SectionHeader/2"
          },
          "images": {}
        },
        {
          "id": "/page/201/Text/8",
          "block_type": "Text",
          "html": "<p>The empty gray square you see when you create a Gui is a Frame. When you create a new widget, it is added to this Frame.</p>",
          "polygon": [
