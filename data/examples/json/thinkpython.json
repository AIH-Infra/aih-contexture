              },
              "images": {}
            },
            {
              "id": "/page/186/ListItem/5",
              "block_type": "ListItem",
              "html": "<li><b>object-oriented programming:</b> A style of programming in which data and the operations that manipulate it are organized into classes and methods.</li>",
              "polygon": [
                [
                  128.3466796875,
                  295.453125
                ],
                [
                  526.0,
                  295.453125
                ],
                [
                  526.0,
                  318.0
                ],
                [
