          "images": {}
        },
        {
          "id": "/page/96/Text/8",
          "block_type": "Text",
          "html": "<p>A <b>method</b> is similar to a function—it takes arguments and returns a value—but the syntax is different. For example, the method upper takes a string and returns a new string with all uppercase letters:</p>",
          "polygon": [
