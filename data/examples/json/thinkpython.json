              357.0
            ],
            [
              85.39013671875,
              357.0
            ]
          ],
          "children": null,
          "section_hierarchy": {
            "1": "/page/200/SectionHeader/1",
            "3": "/page/201/SectionHeader/9"
          },
          "images": {}
        },
        {
          "id": "/page/201/Text/11",
          "block_type": "Text",
          "html": "<p>button = g.bu(text=Press me.)</p>",
          "polygon": [
            [
              85.0166015625,
              360.421875
            ],
            [
              249.0,
              360.421875
            ],
            [
              249.0,
              370.08984375
            ],
            [
              85.0166015625,
              370.08984375
            ]
          ],
          "children": null,
          "section_hierarchy": {
            "1": "/page/200/SectionHeader/1",
            "3": "/page/201/SectionHeader/9"
          },
          "images": {}
        },
        {
          "id": "/page/201/Text/12",
          "block_type": "Text",
          "html": "<p>The return value from bu is a Button object. The button that appears in the Frame is a graphical representation of this object; you can control the button by invoking methods on it.</p>",
          "polygon": [
            [
              85.6142578125,
              376.470703125
            ],
            [
              484.1015625,
              376.470703125
            ],
            [
              484.1015625,
              411.0
            ],
            [
              85.6142578125,
              411.0
            ]
          ],
          "children": null,
          "section_hierarchy": {
            "1": "/page/200/SectionHeader/1",
            "3": "/page/201/SectionHeader/9"
          },
          "images": {}
        },
        {
          "id": "/page/201/Text/13",
          "block_type": "Text",
          "html": "<p>bu takes up to 32 parameters that control the appearance and function of the button. These parameters are called <b>options</b>. Instead of providing values for all 32 options, you can use keyword arguments, like text='Press me.', to specify only the options you need and use the default values for the rest.</p>",
          "polygon": [
            [
              85.166015625,
              420.75
            ],
            [
              483.205078125,
              420.75
            ],
            [
              483.205078125,
              468.0
            ],
            [
              85.166015625,
              468.0
            ]
          ],
          "children": null,
          "section_hierarchy": {
            "1": "/page/200/SectionHeader/1",
            "3": "/page/201/SectionHeader/9"
          },
          "images": {}
        },
        {
          "id": "/page/201/Text/14",
          "block_type": "Text",
          "html": "<p>When you add a widget to the Frame, it gets \"shrink-wrapped;\" that is, the Frame shrinks to the size of the Button. If you add more widgets, the Frame grows to accommodate them.</p>",
          "polygon": [
            [
              85.46484375,
              478.37109375
            ],
            [
              482.90625,
              478.37109375
            ],
            [
              482.90625,
              501.0
            ],
            [
              85.46484375,
              501.0
            ]
          ],
          "children": null,
          "section_hierarchy": {
            "1": "/page/200/SectionHeader/1",
            "3": "/page/201/SectionHeader/9"
          },
          "images": {}
        },
        {
          "id": "/page/201/Text/15",
          "block_type": "Text",
          "html": "<p>The method la creates a Label widget: '</p>",
          "polygon": [
            [
              86.0,
              523.0
            ],
            [
              256.693359375,
              523.0
            ],
            [
              256.693359375,
              536.0
            ],
            [
              86.0,
              536.0
            ]
          ],
          "children": null,
          "section_hierarchy": {
            "1": "/page/200/SectionHeader/1",
            "3": "/page/201/SectionHeader/9"
          },
          "images": {}
        },
        {
          "id": "/page/201/Text/16",
          "block_type": "Text",
          "html": "<p>label = g.la(text=Press the button.)</p>",
          "polygon": [
            [
              85.763671875,
              539.47265625
            ],
            [
              285.0,
              539.47265625
            ],
            [
              285.0,
              550.0
            ],
            [
              85.763671875,
              550.0
            ]
