            "3": "/page/180/SectionHeader/8"
          },
          "images": {}
        },
        {
          "id": "/page/180/Text/18",
          "block_type": "Text",
          "html": "<p>The error message is initially confusing, because there are only two arguments in paren-</p>",
          "polygon": [
            [
