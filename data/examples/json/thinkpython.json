              198.2724609375,
              614.0
            ],
            [
              198.2724609375,
              631.0
            ],
            [
              128.72021484375,
              631.0
            ]
          ],
          "children": null,
          "section_hierarchy": {
            "1": "/page/84/SectionHeader/1",
            "3": "/page/86/SectionHeader/12"
          },
          "images": {}
        },
        {
          "id": "/page/86/Text/13",
          "block_type": "Text",
          "html": "<p>Sometimes you don't know it's time to end a loop until you get half way through the body. In that case you can use the break statement to jump out of the loop.</p>",
          "polygon": [
            [
              128.49609375,
              645.0
            ],
