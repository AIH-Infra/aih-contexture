        {
          "id": "/page/100/Text/18",
          "block_type": "Text",
          "html": "<p>def any_lowercase1(s): for c in s: if c.islower(): return True else: return False def any_lowercase2(s): for c in s: if 'c'.islower(): return 'True'</p>",
