          },
          "images": {}
        },
        {
          "id": "/page/47/Code/7",
          "block_type": "Code",
          "html": "<pre>2.2360679774997898</pre>",
          "polygon": [
            [
              84.64306640625,
              290.619140625
            ],
            [
              181.0,
              290.619140625
            ],
            [
              181.0,
              304.0
