        {
          "id": "/page/108/SectionHeader/2",
          "block_type": "SectionHeader",
          "html": "<h3><b>10.1 A list is a sequence</b></h3>",
          "polygon": [
            [
              128.9443359375,
              291.005859375
            ],
            [
              294.0,
              291.005859375
            ],
            [
              294.0,
