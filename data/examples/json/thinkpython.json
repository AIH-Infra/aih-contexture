            ]
          ],
          "children": [
            {
              "id": "/page/86/ListItem/1",
              "block_type": "ListItem",
              "html": "<li>2. If the condition is false, exit the while statement and continue execution at the next statement.</li>",
              "polygon": [
                [
                  142.0,
                  88.12353515625
                ],
                [
                  526.0,
                  88.12353515625
                ],
                [
                  526.0,
                  111.0
                ],
                [
                  142.0,
