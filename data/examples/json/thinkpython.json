              "images": {}
            },
            {
              "id": "/page/69/ListItem/10",
              "block_type": "ListItem",
              "html": "<li><b>relational operator:</b> One of the operators that compares its operands: ==, !=, &gt;, &lt;, &gt;=, and &lt;=.</li>",
