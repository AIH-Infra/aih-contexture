          "children": null,
          "section_hierarchy": {
            "1": "/page/164/SectionHeader/1",
            "3": "/page/165/SectionHeader/9"
          },
          "images": {}
        },
        {
          "id": "/page/166/Text/5",
          "block_type": "Text",
          "html": "<p>&gt;&gt;&gt; print_point(blank) (3.0, 4.0)</p>",
          "polygon": [
