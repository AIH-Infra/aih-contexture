            "3": "/page/47/SectionHeader/2"
          },
          "images": {}
        },
        {
          "id": "/page/47/Text/9",
          "block_type": "Text",
          "html": "<p>math.sqrt(5)</p>",
          "polygon": [
            [
              85.46484375,
              326.0
            ],
            [
              149.4140625,
