          "children": null,
          "section_hierarchy": {
            "1": "/page/200/SectionHeader/1",
            "3": "/page/201/SectionHeader/9"
          },
          "images": {}
        },
        {
          "id": "/page/201/Text/23",
          "block_type": "Text",
          "html": "<p>'</p>",
          "polygon": [
            [
              275.0,
              526.0
            ],
            [
              280.0,
              526.0
            ],
            [
              280.0,
              536.0
            ],
