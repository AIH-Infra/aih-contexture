          "images": {}
        },
        {
          "id": "/page/201/Text/2",
          "block_type": "Text",
          "html": "<p>This Gui doesn't do much because it doesn't have any <b>widgets</b>. Widgets are the elements that make up a GUI; they include:</p>",
          "polygon": [
            [
              85.6142578125,
              120.26953125
            ],
            [
              482.90625,
              120.26953125
            ],
            [
              482.90625,
              144.0
