              },
              "images": {}
            },
            {
              "id": "/page/131/ListItem/12",
              "block_type": "ListItem",
              "html": "<li><b>value:</b> An object that appears in a dictionary as the second part of a key-value pair. This is more specific than our previous use of the word \"value.\"</li>",
