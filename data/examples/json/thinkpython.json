            ]
          ],
          "children": null,
          "section_hierarchy": {
            "1": "/page/134/SectionHeader/1",
            "3": "/page/138/SectionHeader/3",
            "4": "/page/139/SectionHeader/3"
          },
          "images": {}
        },
        {
          "id": "/page/139/Text/9",
          "block_type": "Text",
          "html": "<p>There are two ways to represent tuples in a state diagram. The more detailed version shows the indices and elements just as they appear in a list. For example, the tuple ('Cleese', 'John') would appear as in Figure 12.1.</p>",
          "polygon": [
            [
              85.46484375,
              375.697265625
            ],
            [
              484.1015625,
