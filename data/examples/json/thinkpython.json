          },
          "images": {}
        },
        {
          "id": "/page/238/Text/5",
          "block_type": "Text",
          "html": "<p>from swampy.Lumpy import Lumpy</p>",
          "polygon": [
            [
              128.794921875,
              449.0
            ],
            [
              287.0,
              449.0
            ],
            [
              287.0,
