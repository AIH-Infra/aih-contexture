        {
          "id": "/page/179/ListGroup/213",
          "block_type": "ListGroup",
          "html": "<p><ul><content-ref src='/page/179/ListItem/1'></content-ref><content-ref src='/page/179/ListItem/2'></content-ref></ul></p>",
          "polygon": [
            [
              98.4638671875,
              86.57666015625
