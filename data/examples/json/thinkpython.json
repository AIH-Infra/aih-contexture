                  85.763671875,
                  572.0
                ]
              ],
              "children": null,
              "section_hierarchy": {
                "1": "/page/52/SectionHeader/1",
                "3": "/page/59/SectionHeader/9"
              },
              "images": {}
            },
            {
              "id": "/page/59/ListItem/13",
              "block_type": "ListItem",
              "html": "<li><b>generalization:</b> The process of replacing something unnecessarily specific (like a number) with something appropriately general (like a variable or parameter).</li>",
              "polygon": [
                [
                  85.6142578125,
                  581.625
                ],
                [
                  484.1015625,
                  581.625
                ],
                [
                  484.1015625,
                  605.0
                ],
                [
