              583.55859375
            ]
          ],
          "children": null,
          "section_hierarchy": {
            "1": "/page/102/SectionHeader/1",
            "3": "/page/103/SectionHeader/15"
          },
          "images": {}
        },
        {
          "id": "/page/104/Text/14",
          "block_type": "Text",
          "html": "<p>This is an example of a program development method called <b>problem recognition</b>, which means that you recognize the problem you are working on as an instance of a previouslysolved problem, and apply a previously-developed solution.</p>",
          "polygon": [
            [
              128.6455078125,
              588.19921875
            ],
            [
              526.0,
              588.19921875
            ],
            [
