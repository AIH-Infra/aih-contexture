            "3": "/page/114/SectionHeader/1"
          },
          "images": {}
        },
        {
          "id": "/page/114/Code/3",
          "block_type": "Code",
          "html": "<pre>&gt;&gt;&gt; s = spam\n                \n&gt;&gt;&gt; t = list(s)\n&gt;&gt;&gt; print t\n['s', 'p', 'a', 'm']</pre>",
          "polygon": [
            [
              129.8408203125,
              153.8173828125
            ],
