        {
          "id": "/page/96/Code/10",
          "block_type": "Code",
          "html": "<pre>&gt;&gt;&gt; word = banana\n                    \n&gt;&gt;&gt; new_word = word.upper()\n&gt;&gt;&gt; print new_word\nBANANA</pre>",
