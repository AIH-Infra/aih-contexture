          },
          "images": {}
        },
        {
          "id": "/page/106/Text/10",
          "block_type": "Text",
          "html": "<p>According to a legendary computer scientist:</p>",
          "polygon": [
            [
              128.86962890625,
              480.3046875
            ],
            [
              327.515625,
              480.3046875
            ],
            [
