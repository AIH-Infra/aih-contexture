          "id": "/page/179/TextInlineMath/8",
          "block_type": "TextInlineMath",
          "html": "<p>&gt;&gt;&gt; start = Time() &gt;&gt;&gt; start.hour = 9 &gt;&gt;&gt; start.minute = 45 &gt;&gt;&gt; start.second = 00 &gt;&gt;&gt; print_time(start) 09:45:00</p>",
          "polygon": [
