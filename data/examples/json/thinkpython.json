          "children": null,
          "section_hierarchy": {
            "1": "/page/92/SectionHeader/1",
            "3": "/page/94/SectionHeader/8"
          },
          "images": {}
        },
        {
          "id": "/page/94/Code/15",
          "block_type": "Code",
          "html": "<pre>&gt;&gt;&gt; fruit = banana&gt;&gt;&gt; fruit[3:3]\n''</pre>",
          "polygon": [
            [
              130.0,
              666.0
            ],
            [
              230.994140625,
              666.0
