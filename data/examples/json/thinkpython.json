                ]
              ],
              "children": null,
              "section_hierarchy": {
                "1": "/page/164/SectionHeader/1",
                "3": "/page/166/SectionHeader/7"
              },
              "images": {}
            },
            {
              "id": "/page/166/ListItem/11",
              "block_type": "ListItem",
              "html": "<li> You could specify two opposing corners.</li>",
              "polygon": [
                [
                  143.0,
                  467.9296875
                ],
                [
                  333.0,
                  467.9296875
                ],
                [
