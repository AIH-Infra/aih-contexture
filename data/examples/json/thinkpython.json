          "children": null,
          "section_hierarchy": {
            "1": "/page/200/SectionHeader/1",
            "3": "/page/200/SectionHeader/2"
          },
          "images": {}
        },
        {
          "id": "/page/201/Text/5",
          "block_type": "Text",
          "html": "<p><b>Entry:</b> A region where users can type text.</p>",
          "polygon": [
            [
