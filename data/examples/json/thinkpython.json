          "images": {}
        },
        {
          "id": "/page/165/FigureGroup/219",
          "block_type": "FigureGroup",
          "html": "<content-ref src='/page/165/Figure/1'></content-ref><content-ref src='/page/165/Caption/2'></content-ref>",
          "polygon": [
            [
              219.4892578125,
