        {
          "id": "/page/178/SectionHeader/1",
          "block_type": "SectionHeader",
          "html": "<h1><b>Classes and methods</b></h1>",
          "polygon": [
            [
              128.3466796875,
              213.662109375
            ],
            [
              368.15625,
              213.662109375
            ],
            [
              368.15625,
