                "3": "/page/176/SectionHeader/13"
              },
              "images": {}
            },
            {
              "id": "/page/177/ListItem/2",
              "block_type": "ListItem",
              "html": "<li><b>modifier:</b> A function that changes one or more of the objects it receives as arguments. Most modifiers are fruitless.</li>",
              "polygon": [
                [
                  85.9130859375,
                  120.462890625
                ],
