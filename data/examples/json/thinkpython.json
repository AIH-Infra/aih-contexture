        {
          "id": "/page/234/Code/4",
          "block_type": "Code",
          "html": "<pre>def countdown(n):\n    if n &lt;= 0:\n        print 'Blastoff!'\n                           \n        lumpy.object_diagram()\n    else:\n        print n\n        countdown(n-1)</pre>",
          "polygon": [
