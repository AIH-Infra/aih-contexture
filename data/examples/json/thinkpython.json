            "3": "/page/207/SectionHeader/9"
          },
          "images": {}
        },
        {
          "id": "/page/208/Text/12",
          "block_type": "Text",
          "html": "<p>drag computes how far the object has moved relative to the starting place, updates the stored coordinates, and then moves the item.</p>",
          "polygon": [
            [
              128.794921875,
              649.6875
            ],
            [
              526.833984375,
              649.6875
            ],
            [
