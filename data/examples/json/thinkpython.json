          },
          "images": {}
        },
        {
          "id": "/page/40/Code/4",
          "block_type": "Code",
          "html": "<pre>&gt;&gt;&gt; type(32)\n&lt;type 'int'&gt;</pre>",
          "polygon": [
            [
              128.57080078125,
              377.0
            ],
            [
              192.4453125,
