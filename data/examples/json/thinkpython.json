        },
        {
          "id": "/page/187/Code/7",
          "block_type": "Code",
          "html": "<pre>color = (0.1, 0.1, 0.9) # mostly blue\nsphere(pos=scene.center, radius=128, color=color)</pre>",
          "polygon": [
