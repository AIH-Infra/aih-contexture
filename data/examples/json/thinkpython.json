          ],
          "children": null,
          "section_hierarchy": {
            "1": "/page/178/SectionHeader/1",
            "3": "/page/181/SectionHeader/8"
          },
          "images": {}
        },
        {
          "id": "/page/181/Text/17",
          "block_type": "Text",
          "html": "<p>If you provide one argument, it overrides hour:</p>",
          "polygon": [
            [
              86.0,
              555.328125
            ],
            [
              296.736328125,
              555.328125
            ],
            [
              295.541015625,
              567.0
            ],
            [
              85.39013671875,
              567.0
            ]
          ],
          "children": null,
          "section_hierarchy": {
            "1": "/page/178/SectionHeader/1",
            "3": "/page/181/SectionHeader/8"
          },
          "images": {}
        },
        {
          "id": "/page/181/Code/18",
          "block_type": "Code",
          "html": "<pre>&gt;&gt;&gt; time = Time (9)\n&gt;&gt;&gt; time.print_time()\n09:00:00</pre>",
          "polygon": [
