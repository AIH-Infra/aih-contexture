            "3": "/page/180/SectionHeader/8"
          },
          "images": {}
        },
        {
          "id": "/page/180/Code/17",
          "block_type": "Code",
          "html": "<pre>&gt;&gt;&gt; end = start.increment(1337, 460)\nTypeError: increment() takes exactly 2 arguments (3 given)</pre>",
          "polygon": [
            [
              129.990234375,
              650.0
