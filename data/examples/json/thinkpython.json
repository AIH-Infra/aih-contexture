      ],
      "children": [
        {
          "id": "/page/175/PageHeader/0",
          "block_type": "PageHeader",
          "html": "<p><b>154 Chapter 16. Classes and functions</b></p>",
          "polygon": [
            [
              86.0,
              60.76318359375
            ],
            [
              482.90625,
              60.76318359375
            ],
            [
              482.90625,
              71.0
            ],
            [
              86.0,
              71.0
            ]
          ],
          "children": null,
          "section_hierarchy": {
            "1": "/page/172/SectionHeader/1",
