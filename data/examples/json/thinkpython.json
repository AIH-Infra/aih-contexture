            "3": "/page/96/SectionHeader/1"
          },
          "images": {}
        },
        {
          "id": "/page/96/Code/3",
          "block_type": "Code",
          "html": "<pre>word = banana\n                \ncount = 0\nfor letter in word:\n    if letter == 'a':\n        count = count + 1\nprint count</pre>",
          "polygon": [
            [
              127.8984375,
              129.0
            ],
            [
              260.0,
              129.0
            ],
            [
              260.0,
              200.0
