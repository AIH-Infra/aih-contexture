              515.0
            ],
            [
              85.6142578125,
              515.0
            ]
          ],
          "children": null,
          "section_hierarchy": {
            "1": "/page/40/SectionHeader/1",
            "3": "/page/45/SectionHeader/8"
          },
          "images": {}
        },
        {
          "id": "/page/45/Code/10",
          "block_type": "Code",
          "html": "<pre>def cat_twice(part1, part2):\n    cat = part1 + part2\n    print_twice(cat)</pre>",
          "polygon": [
            [
              85.46484375,
              518.9765625
            ],
            [
              233.0,
              518.9765625
            ],
            [
              233.0,
              556.1015625
            ],
            [
