                  605.0
                ]
              ],
              "children": null,
              "section_hierarchy": {
                "1": "/page/52/SectionHeader/1",
                "3": "/page/59/SectionHeader/9"
              },
              "images": {}
            },
            {
              "id": "/page/59/ListItem/14",
              "block_type": "ListItem",
              "html": "<li><b>keyword argument:</b> An argument that includes the name of the parameter as a \"keyword.\"</li>",
              "polygon": [
                [
                  86.0,
                  613.72265625
                ],
                [
                  482.90625,
                  613.72265625
                ],
                [
                  482.90625,
                  637.0
                ],
                [
                  86.0,
                  637.0
                ]
              ],
              "children": null,
              "section_hierarchy": {
                "1": "/page/52/SectionHeader/1",
                "3": "/page/59/SectionHeader/9"
              },
              "images": {}
            },
            {
              "id": "/page/59/ListItem/15",
              "block_type": "ListItem",
              "html": "<li><b>interface:</b> A description of how to use a function, including the name and descriptions of the arguments and return value.</li>",
              "polygon": [
                [
                  86.0,
                  646.0
                ],
                [
                  483.50390625,
                  646.0
                ],
                [
                  483.50390625,
                  669.0
                ],
                [
                  86.0,
                  669.0
                ]
              ],
              "children": null,
              "section_hierarchy": {
                "1": "/page/52/SectionHeader/1",
                "3": "/page/59/SectionHeader/9"
              },
              "images": {}
            },
            {
              "id": "/page/59/ListItem/16",
              "block_type": "ListItem",
              "html": "<li><b>refactoring:</b> The process of modifying a working program to improve function interfaces and other qualities of the code.</li>",
              "polygon": [
