            ]
          ],
          "children": null,
          "section_hierarchy": {
            "1": "/page/40/SectionHeader/1",
            "3": "/page/47/SectionHeader/2"
          },
          "images": {}
        },
        {
          "id": "/page/47/Text/8",
          "block_type": "Text",
          "html": "<p>But in a script, if you call a fruitful function all by itself, the return value is lost forever!</p>",
          "polygon": [
            [
              85.46484375,
              308.98828125
            ],
            [
              468.861328125,
