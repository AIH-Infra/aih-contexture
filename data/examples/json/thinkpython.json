                "1": "/page/72/SectionHeader/1",
                "3": "/page/73/SectionHeader/8"
              },
              "images": {}
            },
            {
              "id": "/page/75/ListItem/2",
              "block_type": "ListItem",
              "html": "<li>3. Once the program is working, you might want to remove some of the scaffolding or consolidate multiple statements into compound expressions, but only if it does not make the program difficult to read.</li>",
              "polygon": [
                [
                  98.314453125,
