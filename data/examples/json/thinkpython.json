              673.0
            ],
            [
              128.794921875,
              673.0
            ]
          ],
          "children": null,
          "section_hierarchy": {
            "1": "/page/200/SectionHeader/1",
            "3": "/page/207/SectionHeader/9"
          },
          "images": {}
        },
        {
          "id": "/page/208/Code/13",
          "block_type": "Code",
          "html": "<pre>def drag(self, event):\n   dx = event.x - self.dragx</pre>",
          "polygon": [
            [
              151.0,
              679.0
