        {
          "id": "/page/58/Code/15",
          "block_type": "Code",
          "html": "<pre>def polyline(t, n, length, angle):\n    \"\"\"Draws n line segments with the given length and\n    angle (in degrees) between them. t is a turtle.\n    \"\"\"\n    for i in range(n):\n        fd(t, length)\n        lt(t, angle)</pre>",
