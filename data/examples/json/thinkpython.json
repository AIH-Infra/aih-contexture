          ],
          "children": null,
          "section_hierarchy": {
            "1": "/page/40/SectionHeader/1",
            "3": "/page/42/SectionHeader/9"
          },
          "images": {}
        },
        {
          "id": "/page/43/Code/8",
          "block_type": "Code",
          "html": "<pre>def repeat_lyrics():\n    print_lyrics()\n    print_lyrics()\nAnd then call repeat_lyrics:</pre>",
          "polygon": [
