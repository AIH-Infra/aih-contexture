        },
        {
          "id": "/page/47/Text/1",
          "block_type": "Text",
          "html": "<p>The order of the functions in the traceback is the same as the order of the frames in the stack diagram. The function that is currently running is at the bottom.</p>",
          "polygon": [
            [
              85.763671875,
              87.3984375
            ],
            [
              482.90625,
              87.3984375
            ],
            [
              482.90625,
              111.0
            ],
            [
