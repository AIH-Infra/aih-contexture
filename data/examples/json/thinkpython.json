            ],
            [
              526.0,
              667.86328125
            ],
            [
              128.49609375,
              667.86328125
            ]
          ],
          "children": null,
          "section_hierarchy": {
            "1": "/page/84/SectionHeader/1",
            "3": "/page/86/SectionHeader/12"
          },
          "images": {}
        },
        {
          "id": "/page/86/Text/14",
          "block_type": "Text",
          "html": "<p>For example, suppose you want to take input from the user until they type done. You could write:</p>",
          "polygon": [
            [
              128.49609375,
              677.53125
            ],
            [
              526.53515625,
              677.53125
            ],
            [
              526.53515625,
              701.0
            ],
            [
              128.49609375,
              701.0
            ]
          ],
          "children": null,
          "section_hierarchy": {
            "1": "/page/84/SectionHeader/1",
            "3": "/page/86/SectionHeader/12"
          },
          "images": {}
        }
      ],
      "section_hierarchy": {
        "1": "/page/84/SectionHeader/1",
        "3": "/page/86/SectionHeader/12"
