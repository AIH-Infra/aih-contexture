        },
        {
          "id": "/page/114/Text/2",
          "block_type": "Text",
          "html": "<p>A string is a sequence of characters and a list is a sequence of values, but a list of characters is not the same as a string. To convert from a string to a list of characters, you can use list:</p>",
          "polygon": [
            [
              128.6455078125,
              113.0
            ],
            [
              526.0,
              113.0
            ],
            [
              526.0,
              136.125
