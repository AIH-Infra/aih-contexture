            "3": "/page/67/SectionHeader/3"
          },
          "images": {}
        },
        {
          "id": "/page/67/Text/8",
          "block_type": "Text",
          "html": "<p>RuntimeError: Maximum recursion depth exceeded</p>",
          "polygon": [
