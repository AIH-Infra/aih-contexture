          },
          "images": {}
        },
        {
          "id": "/page/32/Text/11",
          "block_type": "Text",
          "html": "<p>When you type a large integer, you might be tempted to use commas between groups of three digits, as in 1,000,000. This is not a legal integer in Python, but it is legal:</p>",
          "polygon": [
            [
              128.49609375,
