          "children": null,
          "section_hierarchy": {
            "1": "/page/154/SectionHeader/1",
            "3": "/page/155/SectionHeader/3"
          },
          "images": {}
        },
        {
          "id": "/page/155/Text/4",
          "block_type": "Text",
          "html": "<p>The argument of write has to be a string, so if we want to put other values in a file, we have to convert them to strings. The easiest way to do that is with str:</p>",
          "polygon": [
            [
              86.0,
              252.333984375
            ],
            [
              482.90625,
              252.333984375
            ],
            [
              482.90625,
              276.0
            ],
            [
