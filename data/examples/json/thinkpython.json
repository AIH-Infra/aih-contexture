      "children": [
        {
          "id": "/page/93/PageHeader/0",
          "block_type": "PageHeader",
          "html": "<p><b>72 Chapter 8. Strings</b></p>",
          "polygon": [
            [
              86.0,
              60.8115234375
            ],
            [
              483.50390625,
              60.8115234375
            ],
