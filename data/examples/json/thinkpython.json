            "3": "/page/33/SectionHeader/14"
          },
          "images": {}
        },
        {
          "id": "/page/34/Text/8",
          "block_type": "Text",
          "html": "<p>In Python 3, exec is no longer a keyword, but nonlocal is.</p>",
          "polygon": [
            [
              128.197265625,
              381.3046875
            ],
            [
              388.177734375,
              381.3046875
            ],
            [
              388.177734375,
              392.0
            ],
            [
              128.197265625,
              392.0
            ]
          ],
          "children": null,
          "section_hierarchy": {
            "1": "/page/32/SectionHeader/1",
            "3": "/page/33/SectionHeader/14"
          },
          "images": {}
        },
        {
          "id": "/page/34/Text/9",
          "block_type": "Text",
          "html": "<p>You might want to keep this list handy. If the interpreter complains about one of your variable names and you don't know why, see if it is on this list.</p>",
          "polygon": [
            [
              128.6455078125,
              401.0
            ],
            [
              526.53515625,
              401.0
            ],
            [
              526.53515625,
              424.0
