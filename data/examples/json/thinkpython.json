          },
          "images": {}
        },
        {
          "id": "/page/177/Text/6",
          "block_type": "Text",
          "html": "<p>Code examples from this chapter are available from http://thinkpython.com/code/ Time1.py; solutions to these exercises are available from http://thinkpython.com/code/ Time1_soln.py.</p>",
          "polygon": [
            [
              85.9130859375,
