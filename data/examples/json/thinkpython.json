            ],
            [
              526.0,
              147.0
            ],
            [
              128.0478515625,
              147.0
            ]
          ],
          "children": null,
          "section_hierarchy": {
            "1": "/page/22/SectionHeader/1",
            "3": "/page/30/SectionHeader/1"
          },
          "images": {}
        },
        {
          "id": "/page/30/Text/3",
          "block_type": "Text",
          "html": "<p><i>For example, if you enter</i> print <i>in the search window, the first link that appears is the documenta</i><i>tion of the</i> print <i>statement. At this point, not all of it will make sense to you, but it is good to know</i> <i>where it is.</i></p>",
          "polygon": [
            [
              129.09375,
              156.041015625
            ],
            [
              526.0,
              156.041015625
            ],
            [
              526.0,
              191.0
            ],
            [
              129.09375,
              191.0
            ]
          ],
          "children": null,
          "section_hierarchy": {
            "1": "/page/22/SectionHeader/1",
            "3": "/page/30/SectionHeader/1"
          },
          "images": {}
        },
        {
          "id": "/page/30/Text/4",
          "block_type": "Text",
          "html": "<p><b>Exercise 1.3.</b> <i>Start the Python interpreter and type</i> help() <i>to start the online help utility. Or you</i> <i>can type</i> help('print') <i>to get information about the</i> print <i>statement.</i></p>",
          "polygon": [
            [
              128.3466796875,
              192.0
            ],
            [
              526.0,
              192.0
            ],
            [
              526.0,
              216.369140625
            ],
            [
              128.3466796875,
              216.369140625
            ]
          ],
          "children": null,
          "section_hierarchy": {
            "1": "/page/22/SectionHeader/1",
            "3": "/page/30/SectionHeader/1"
          },
          "images": {}
        },
        {
          "id": "/page/30/Text/5",
          "block_type": "Text",
          "html": "<p><i>If this example doesn't work, you may need to install additional Python documentation or set an</i> <i>environment variable; the details depend on your operating system and version of Python.</i></p>",
          "polygon": [
            [
              128.9443359375,
              224.68359375
            ],
