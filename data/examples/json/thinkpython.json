              292.166015625
            ]
          ],
          "children": null,
          "section_hierarchy": {
            "1": "/page/134/SectionHeader/1",
            "3": "/page/138/SectionHeader/3"
          },
          "images": {}
        },
        {
          "id": "/page/138/Text/6",
          "block_type": "Text",
          "html": "<p>As you should expect from a dictionary, the items are in no particular order. In Python 3, items returns an iterator, but for many purposes, iterators behave like lists.</p>",
