              "children": null,
              "section_hierarchy": {
                "1": "/page/178/SectionHeader/1",
                "3": "/page/186/SectionHeader/3"
              },
              "images": {}
            },
            {
              "id": "/page/186/ListItem/6",
              "block_type": "ListItem",
              "html": "<li><b>method:</b> A function that is defined inside a class definition and is invoked on instances of that class.</li>",
              "polygon": [
                [
                  128.3466796875,
                  329.0
                ],
                [
                  526.0,
                  329.0
                ],
