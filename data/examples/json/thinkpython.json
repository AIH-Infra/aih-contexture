          "children": null,
          "section_hierarchy": {
            "1": "/page/188/SectionHeader/1",
            "3": "/page/192/SectionHeader/8"
          },
          "images": {}
        },
        {
          "id": "/page/192/Text/9",
          "block_type": "Text",
          "html": "<p>To deal cards, we would like a method that removes a card from the deck and returns it. The list method pop provides a convenient way to do that:</p>",
          "polygon": [
            [
              128.197265625,
              483.78515625
            ],
            [
              526.0,
              483.78515625
            ],
            [
              526.0,
              506.98828125
            ],
            [
              128.197265625,
              506.98828125
            ]
          ],
          "children": null,
          "section_hierarchy": {
            "1": "/page/188/SectionHeader/1",
            "3": "/page/192/SectionHeader/8"
          },
          "images": {}
        },
        {
          "id": "/page/192/Text/10",
          "block_type": "Text",
          "html": "<p>#inside class Deck:</p>",
          "polygon": [
            [
              128.9443359375,
              512.0
            ],
            [
              229.0,
              512.0
            ],
            [
              229.0,
              522.0703125
