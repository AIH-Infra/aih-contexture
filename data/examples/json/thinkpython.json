            "3": "/page/116/SectionHeader/11"
          },
          "images": {}
        },
        {
          "id": "/page/116/Code/15",
          "block_type": "Code",
          "html": "<pre>&gt;&gt;&gt; letters = [a, b, c]\n&gt;&gt;&gt; delete_head(letters)\n&gt;&gt;&gt; print letters\n['b', 'c']</pre>",
