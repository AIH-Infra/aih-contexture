          "children": null,
          "section_hierarchy": {
            "1": "/page/84/SectionHeader/1",
            "3": "/page/89/SectionHeader/13"
          },
          "images": {}
        },
        {
          "id": "/page/89/Text/14",
          "block_type": "Text",
          "html": "<p><b>multiple assignment:</b> Making more than one assignment to the same variable during the execution of a program.</p>",
