        },
        {
          "id": "/page/114/Text/13",
          "block_type": "Text",
          "html": "<p>If we execute these assignment statements: ''</p>",
          "polygon": [
            [
              128.86962890625,
              578.91796875
            ],
            [
              318.251953125,
              578.91796875
            ],
            [
              318.251953125,
              593.0
            ],
            [
              128.86962890625,
              593.0
            ]
