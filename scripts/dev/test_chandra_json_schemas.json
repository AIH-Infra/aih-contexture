{
  "schemas": {
    "basic_ocr": {
      "name": "基础 OCR 输出",
      "description": "最简单的结构化输出，只包含文本和坐标",
      "schema": {
        "type": "object",
        "properties": {
          "blocks": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "text": {
                  "type": "string",
                  "description": "识别的文本内容"
                },
                "bbox": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 4,
                  "maxItems": 4,
                  "description": "边界框坐标 [x1, y1, x2, y2]"
                },
                "type": {
                  "type": "string",
                  "enum": ["text", "title", "table", "figure", "equation"],
                  "description": "块类型"
                }
              },
              "required": ["text", "bbox", "type"]
            }
          }
        },
        "required": ["blocks"]
      }
    },
    "detailed_ocr": {
      "name": "详细 OCR 输出",
      "description": "包含更多元数据的结构化输出",
      "schema": {
        "type": "object",
        "properties": {
          "page": {
            "type": "object",
            "properties": {
              "width": {
                "type": "number"
              },
              "height": {
                "type": "number"
              }
            },
            "required": ["width", "height"]
          },
          "blocks": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "description": "块的唯一标识符"
                },
                "type": {
                  "type": "string",
                  "enum": ["text", "title", "subtitle", "table", "figure", "equation", "list", "code"],
                  "description": "块类型"
                },
                "text": {
                  "type": "string",
                  "description": "文本内容"
                },
                "bbox": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 4,
                  "maxItems": 4,
                  "description": "[x1, y1, x2, y2]"
                },
                "confidence": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1,
                  "description": "识别置信度"
                },
                "formatting": {
                  "type": "object",
                  "properties": {
                    "bold": {
                      "type": "boolean"
                    },
                    "italic": {
                      "type": "boolean"
                    },
                    "underline": {
                      "type": "boolean"
                    }
                  }
                }
              },
              "required": ["id", "type", "text", "bbox"]
            }
          }
        },
        "required": ["page", "blocks"]
      }
    },
    "hierarchical_ocr": {
      "name": "层次化 OCR 输出",
      "description": "包含段落、行、词的层次结构",
      "schema": {
        "type": "object",
        "properties": {
          "document": {
            "type": "object",
            "properties": {
              "blocks": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "enum": ["paragraph", "heading", "table", "figure"]
                    },
                    "bbox": {
                      "type": "array",
                      "items": {
                        "type": "number"
                      },
                      "minItems": 4,
                      "maxItems": 4
                    },
                    "lines": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "text": {
                            "type": "string"
                          },
                          "bbox": {
                            "type": "array",
                            "items": {
                              "type": "number"
                            },
                            "minItems": 4,
                            "maxItems": 4
                          },
                          "words": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "properties": {
                                "text": {
                                  "type": "string"
                                },
                                "bbox": {
                                  "type": "array",
                                  "items": {
                                    "type": "number"
                                  },
                                  "minItems": 4,
                                  "maxItems": 4
                                }
                              },
                              "required": ["text", "bbox"]
                            }
                          }
                        },
                        "required": ["text", "bbox"]
                      }
                    }
                  },
                  "required": ["type", "bbox", "lines"]
                }
              }
            },
            "required": ["blocks"]
          }
        },
        "required": ["document"]
      }
    }
  }
}
